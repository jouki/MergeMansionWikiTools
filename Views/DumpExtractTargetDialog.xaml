<ui:FluentWindow x:Class="MergeMansionWikiTools.Views.DumpExtractTargetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Extract dump" Height="330" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Extract dump — choose version" Height="36" />

        <Grid Grid.Row="1" Margin="24,12,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="txtInfo" Grid.Row="0" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,14"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <RadioButton x:Name="rbAssigned" Grid.Row="1" GroupName="target" Margin="0,0,0,6"
                         Checked="Target_Changed" />
            <RadioButton x:Name="rbOther" Grid.Row="2" GroupName="target"
                         Content="Extract to another version:" Checked="Target_Changed" />
            <ComboBox x:Name="cmbVersion" Grid.Row="3" IsEditable="True" Margin="24,4,0,0"
                      HorizontalAlignment="Stretch" IsEnabled="False" />
            <TextBlock Grid.Row="3" Margin="28,30,0,0" FontSize="11"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="Existing folder or a new version (created if missing)." />

            <CheckBox x:Name="chkSwitch" Grid.Row="4" Margin="0,22,0,0" IsChecked="True"
                      Content="Switch my working version to the chosen version" />

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button Content="Extract" Appearance="Primary" Click="BtnOk_Click" Margin="0,0,8,0" />
                <ui:Button Content="Cancel" Appearance="Secondary" Click="BtnCancel_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
