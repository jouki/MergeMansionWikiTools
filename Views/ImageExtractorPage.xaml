<UserControl x:Class="MergeMansionWikiTools.Views.ImageExtractorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
        <StackPanel MaxWidth="900">

            <TextBlock Text="Image Extractor" FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="4,0,0,24" />

            <!-- ══ EXTRACT ASSETS ═══════════════════════════════════════ -->
            <Grid Margin="4,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Extract Assets" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center" />
                <ui:Button x:Name="btnOpenExportFolder" Grid.Column="1"
                           Content="Open Export Folder" Appearance="Secondary"
                           Height="34" Visibility="Collapsed"
                           Click="BtnOpenExportFolder_Click" />
            </Grid>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    Margin="0,0,0,16">
                <StackPanel>

                    <!-- ── From Server ──────────────────────────────── -->
                    <TextBlock Text="From Server" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="16,14,16,6" />

                    <!-- Status -->
                    <TextBlock x:Name="txtServerDetected" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="16,0,16,10" />

                    <!-- Warning panel -->
                    <StackPanel x:Name="panelNoServerApk" Visibility="Collapsed" Margin="16,0,16,10">
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}">
                            <Run Text="No APK/XAPK or catalog.bin found for the selected game version. Download the APK first in Settings." />
                        </TextBlock>
                        <ui:Button Content="Go to Settings" Appearance="Secondary" Margin="0,8,0,0"
                                   Height="34" Click="BtnGoToApkSettings_Click" />
                    </StackPanel>

                    <!-- Output path preview -->
                    <TextBlock x:Name="txtServerAutoPath" FontSize="11"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="16,0,16,10" TextWrapping="Wrap" />

                    <!-- Action row -->
                    <Grid Margin="16,0,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button x:Name="btnServerExtract" Grid.Column="0"
                                   Content="Extract Images" Appearance="Primary"
                                   Height="38" Padding="20,0"
                                   Click="BtnServerExtract_Click" />
                        <ui:Button x:Name="btnCancelServer" Grid.Column="1"
                                   Content="Cancel" Appearance="Secondary"
                                   Height="38" Margin="8,0,0,0"
                                   Visibility="Collapsed"
                                   Click="BtnCancelServer_Click" />
                        <TextBlock x:Name="txtServerProgress" Grid.Column="2"
                                   FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="12,0,0,0" TextWrapping="Wrap" />
                    </Grid>

                    <ui:InfoBar x:Name="serverInfoBar" IsOpen="False" IsClosable="True"
                                Margin="16,0,16,12" />

                    <!-- ── Separator ────────────────────────────────── -->
                    <Separator Opacity="0.15" Margin="0" />

                    <!-- ── From APK ─────────────────────────────────── -->
                    <TextBlock Text="From APK" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="16,14,16,6" />

                    <!-- Status -->
                    <TextBlock x:Name="txtExtractDetected" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="16,0,16,10" />

                    <!-- Warning panel (no APK) -->
                    <StackPanel x:Name="panelNoExtractApk" Visibility="Collapsed" Margin="16,0,16,10">
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}">
                            <Run Text="No APK/XAPK found for the selected game version. Download it first or select a version in Settings." />
                        </TextBlock>
                        <ui:Button Content="Go to Settings" Appearance="Secondary" Margin="0,8,0,0"
                                   Height="34" Click="BtnGoToApkSettings_Click" />
                    </StackPanel>

                    <!-- Output path preview -->
                    <TextBlock x:Name="txtExtractAutoPath" FontSize="11"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="16,0,16,10" TextWrapping="Wrap" />

                    <!-- Action row -->
                    <Grid Margin="16,0,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button x:Name="btnExtractAssets" Grid.Column="0"
                                   Content="Extract Images" Appearance="Primary"
                                   Height="38" Padding="20,0"
                                   Click="BtnExtractAssets_Click" />
                        <ui:Button x:Name="btnCancelExtract" Grid.Column="1"
                                   Content="Cancel" Appearance="Secondary"
                                   Height="38" Margin="8,0,0,0"
                                   Visibility="Collapsed"
                                   Click="BtnCancelExtract_Click" />
                        <TextBlock x:Name="txtExtractProgress" Grid.Column="2"
                                   FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="12,0,0,0" TextWrapping="Wrap" />
                    </Grid>

                    <ui:InfoBar x:Name="extractInfoBar" IsOpen="False" IsClosable="True"
                                Margin="16,0,16,12" />

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
