<UserControl x:Class="MergeMansionWikiTools.Views.EventsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:MergeMansionWikiTools.Views">

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Events" FontSize="28" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="[WIP]" FontSize="14" VerticalAlignment="Bottom" Margin="8,0,0,4"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </StackPanel>

            <ui:TextBox x:Name="txtSearch" Grid.Column="1"
                        PlaceholderText="Search events..." Margin="16,0"
                        Icon="{ui:SymbolIcon Search24}"
                        TextChanged="TxtSearch_TextChanged"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="chkShowDisabled" Content="Show disabled"
                          Margin="0,0,16,0" VerticalAlignment="Center"
                          Checked="ChkShowDisabled_Changed" Unchecked="ChkShowDisabled_Changed"/>
                <TextBlock x:Name="txtSummary" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Row 1: Split content (left list + right detail/flowchart, equal height) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: event list -->
            <Border Grid.Column="0" CornerRadius="8" Margin="0,0,12,0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <!-- Virtualizovaný seznam (rok-headery + karty eventů jako heterogenní položky;
                     ItemsControl s vlastním templatem = ScrollViewer uvnitř, jinak by vnější
                     ScrollViewer virtualizaci zabil). -->
                <ItemsControl x:Name="eventListControl"
                              Focusable="False"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel">
                    <ItemsControl.Resources>
                        <BooleanToVisibilityConverter x:Key="BoolToVis" />
                        <!-- Rok-header: oddělovací linka + nadpis roku (linka je i před prvním
                             headerem — 1:1 s původním ručním buildem) -->
                        <DataTemplate DataType="{x:Type views:EventYearHeaderItem}">
                            <StackPanel>
                                <Border Height="1" Margin="4,8,4,0"
                                        Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                                <TextBlock Text="{Binding YearText}"
                                           FontSize="18" FontWeight="Bold"
                                           Margin="4,16,0,6"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>

                        <!-- Karta eventu -->
                        <DataTemplate DataType="{x:Type views:EventCardItem}">
                            <Border CornerRadius="6" Margin="0,1,0,1" Padding="0"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="EventCard_MouseLeftButtonUp">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <!-- Disabled event: ztlumit celou kartu -->
                                            <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                <Setter Property="Opacity" Value="0.45"/>
                                            </DataTrigger>
                                            <!-- Hover jen pokud karta není vybraná (1:1 s původním MouseEnter/Leave) -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsSelected}" Value="False"/>
                                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                            </MultiDataTrigger>
                                            <!-- Zvýraznění po kliknutí (rebuild seznamu ho resetuje — 1:1) -->
                                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid Margin="8,6,8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" Height="36" Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                                        <Image Source="{Binding BadgeImage}" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <!-- Disabled chip -->
                                            <Border Margin="6,0,0,0" Padding="5,0" VerticalAlignment="Center"
                                                    CornerRadius="3"
                                                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                                    Visibility="{Binding IsDisabled, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="disabled" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding InfoText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.Resources>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer Padding="8" VerticalScrollBarVisibility="Auto"
                                          CanContentScroll="True">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                </ItemsControl>
            </Border>

            <!-- Right: event detail + flowchart -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Event header -->
                <StackPanel x:Name="eventDetailPanel" Grid.Row="0" Margin="0,0,0,8"
                            Visibility="Collapsed">
                    <TextBlock x:Name="txtEventName" FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock x:Name="txtEventInfo" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Chain list (collapsible) -->
                <Expander x:Name="chainExpander" Grid.Row="1" Header="Chains"
                          Margin="0,0,0,8" Visibility="Collapsed">
                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="chainListPanel"/>
                    </ScrollViewer>
                </Expander>

                <!-- Flowchart placeholder -->
                <Border Grid.Row="2" CornerRadius="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <TextBlock x:Name="txtPlaceholder" Text="Select an event to view its item chain flowchart."
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="14"/>
                </Border>
            </Grid>
        </Grid>

        <!-- Row 2: Buttons (own row, aligned under the right panel so the list ends level with it) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0"
                        HorizontalAlignment="Right">
                <ui:Button x:Name="btnGenerateGc" Content="Generate Garage Cleanup"
                           Icon="{ui:SymbolIcon Grid24}"
                           Click="BtnGenerateGc_Click"
                           IsEnabled="False" Margin="0,0,8,0"/>
                <ui:Button x:Name="btnGenerateFlowchart" Content="Generate Flowchart"
                           Icon="{ui:SymbolIcon FlowchartCircle24}"
                           Appearance="Primary" Click="BtnGenerateFlowchart_Click"
                           IsEnabled="False" Margin="0,0,8,0"/>
                <ui:Button x:Name="btnSaveSvg" Content="Save SVG"
                           Icon="{ui:SymbolIcon Save24}"
                           Click="BtnSaveSvg_Click" IsEnabled="False" Margin="0,0,8,0"/>
                <ui:Button x:Name="btnOpenFlowchart" Content="Open"
                           Icon="{ui:SymbolIcon Open24}"
                           Click="BtnOpenFlowchart_Click" IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <!-- Row 3: InfoBar -->
        <ui:InfoBar x:Name="infoBar" Grid.Row="3" IsOpen="False" IsClosable="True" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
