<ui:FluentWindow x:Class="MergeMansionWikiTools.Views.GcPageUpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Update Garage Cleanup section?" Width="1020" Height="660"
        MinWidth="720" MinHeight="420"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Height="36" Title="Update Garage Cleanup section?" />

        <Grid Grid.Row="1" Margin="24,12,24,20">
            <Grid.RowDefinitions>
                <!-- Page name -->
                <RowDefinition Height="Auto" />
                <!-- Subtitle: action + stats -->
                <RowDefinition Height="Auto" />
                <!-- Separator -->
                <RowDefinition Height="Auto" />
                <!-- Diff panes -->
                <RowDefinition Height="*" />
                <!-- Bottom buttons -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="txtPage"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="0,0,0,6" />

            <TextBlock Grid.Row="1" x:Name="txtSubtitle"
                       FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Margin="0,0,0,10" />

            <Border Grid.Row="2" Height="1" Margin="0,0,0,12"
                    Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

            <!-- Side-by-side diff (left = current wiki, right = new section) -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Current wiki section"
                           FontSize="12" FontWeight="SemiBold" Margin="2,0,0,6"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="New section"
                           FontSize="12" FontWeight="SemiBold" Margin="2,0,0,6"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <Border Grid.Row="1" Grid.Column="0" CornerRadius="4"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                    <ScrollViewer x:Name="scrollLeft"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                  ScrollChanged="ScrollLeft_ScrollChanged">
                        <StackPanel x:Name="pnlLeft" Margin="8,6,8,6" />
                    </ScrollViewer>
                </Border>

                <Border Grid.Row="1" Grid.Column="2" CornerRadius="4"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                    <ScrollViewer x:Name="scrollRight"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                  ScrollChanged="ScrollRight_ScrollChanged">
                        <StackPanel x:Name="pnlRight" Margin="8,6,8,6" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Bottom buttons -->
            <Grid Grid.Row="4" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="1"
                           Content="Skip this page"
                           Appearance="Secondary"
                           Click="BtnSkip_Click"
                           VerticalAlignment="Stretch" />

                <ui:Button Grid.Column="3"
                           Content="Update page"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon ArrowUpload24}"
                           Click="BtnUpdate_Click"
                           VerticalAlignment="Stretch" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
