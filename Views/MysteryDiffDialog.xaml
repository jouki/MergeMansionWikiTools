<ui:FluentWindow x:Class="MergeMansionWikiTools.Views.MysteryDiffDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Mystery Diff" Height="750" Width="1100"
        MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Height="36">
            <ui:TitleBar.Header>
                <TextBlock x:Name="txtTitle" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="24,10,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Mystery info header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock x:Name="txtMysteryName" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="txtMysteryDetail" FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Margin="0,3,0,0" />
            </StackPanel>

            <!-- Column headers -->
            <Grid Grid.Row="1" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Wiki (current)" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="4,0,0,0" />
                <TextBlock Grid.Column="1" Text="Generated (new)" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="8,0,0,0" />
            </Grid>

            <!-- Content area -->
            <Grid Grid.Row="2">
                <!-- Loading indicator -->
                <StackPanel x:Name="pnlLoading" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40" />
                    <TextBlock Text="Fetching wiki content..." FontSize="13" Margin="0,12,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Diff view: two-column synced scroll -->
                <Grid x:Name="pnlDiff" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" CornerRadius="4,0,0,4" BorderThickness="1,1,0,1"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                        <ScrollViewer x:Name="scrollLeft" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      ScrollChanged="ScrollLeft_ScrollChanged">
                            <StackPanel x:Name="pnlLeft" Margin="8,6,8,6" />
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{DynamicResource CardStrokeColorDefaultBrush}" />

                    <Border Grid.Column="2" CornerRadius="0,4,4,0" BorderThickness="0,1,1,1"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                        <ScrollViewer x:Name="scrollRight" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      ScrollChanged="ScrollRight_ScrollChanged">
                            <StackPanel x:Name="pnlRight" Margin="8,6,8,6" />
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Page not found -->
                <StackPanel x:Name="pnlNotFound" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="DocumentDismiss24" FontSize="36"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="txtNotFound" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,4" TextWrapping="Wrap" />
                    <TextBlock Text="The page does not exist on the wiki yet."
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- No differences -->
                <StackPanel x:Name="pnlNoDiffs" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="Checkmark24" FontSize="36"
                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                    <TextBlock Text="No differences found" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,4" />
                    <TextBlock Text="Wiki content matches the generated output."
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Error -->
                <StackPanel x:Name="pnlError" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="36"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    <TextBlock x:Name="txtError" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,0"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="400" />
                </StackPanel>
            </Grid>

            <!-- Bottom: stats + close button -->
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="txtStats" Grid.Column="0" FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center" />

                <ui:Button Grid.Column="1" Content="Close" Appearance="Primary"
                           Click="BtnClose_Click" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
