<ui:FluentWindow x:Class="MergeMansionWikiTools.Views.BotSetupGuideDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Bot Password Setup Guide"
                 Width="560" Height="620"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="CanResize"
                 MinWidth="400" MinHeight="400"
                 ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Bot Password Setup Guide" Height="42" />

        <Grid Grid.Row="1" Margin="24,4,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Setting up your Bot Password"
                   FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   Margin="0,0,0,16" />

        <!-- Steps -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Step 1 -->
                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                                CornerRadius="12" Width="24" Height="24">
                            <TextBlock Text="1" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Open Special:BotPasswords" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="34,0,0,6">
                        <Run Text="Make sure you are logged in to the Merge Mansion wiki, then go to:" />
                    </TextBlock>
                    <TextBlock Margin="34,0,0,0" FontSize="12">
                        <Hyperlink NavigateUri="https://merge-mansion.fandom.com/wiki/Special:BotPasswords"
                                   RequestNavigate="Hyperlink_Navigate">
                            <Run Text="merge-mansion.fandom.com/wiki/Special:BotPasswords" />
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

                <!-- Step 2 -->
                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                                CornerRadius="12" Width="24" Height="24">
                            <TextBlock Text="2" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Create a new bot" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="34,0,0,0">
                        <Run Text="Enter a name for the bot — use your username followed by " />
                        <Run Text="_bot" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Run Text=" (e.g. " /><Run Text="Jouki_bot" FontStyle="Italic" /><Run Text=")." />
                    </TextBlock>
                </StackPanel>

                <!-- Step 3 -->
                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                                CornerRadius="12" Width="24" Height="24">
                            <TextBlock Text="3" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Select all permissions" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="34,0,0,0">
                        <Run Text="On the next page, check all available permissions and click " />
                        <Run Text="Create" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /><Run Text="." />
                    </TextBlock>
                </StackPanel>

                <!-- Step 4 -->
                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                                CornerRadius="12" Width="24" Height="24">
                            <TextBlock Text="4" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Copy your credentials" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="34,0,0,6">
                        <Run Text="Fandom will show a confirmation message like this:" />
                    </TextBlock>
                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="6" Margin="34,8,0,8" Padding="12,10">
                        <TextBlock FontSize="12" TextWrapping="Wrap" FontFamily="Consolas"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <Run Text="The new password to log in with " />
                            <Run Text="Jouki@Jouki_bot" FontWeight="Bold"
                                 Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <Run Text=" is " />
                            <Run Text="j5uh4ctlfgh71ipma5lvacsp0hs2q71u" FontWeight="Bold"
                                 Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <Run Text=". Please record this for future reference." />
                        </TextBlock>
                    </Border>
                    <Grid Margin="34,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Username:" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="0" Grid.Column="1" FontSize="12" Margin="0,0,0,4"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold"
                                   Text="Jouki@Jouki_bot" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Password:" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold"
                                   Text="j5uh4ctlfgh71ipma5lvacsp0hs2q71u" />
                    </Grid>
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="34,10,0,0">
                        <Run Text="Paste these into the fields in Settings and click " />
                        <Run Text="Log In" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /><Run Text="." />
                    </TextBlock>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Close button -->
        <ui:Button Grid.Row="2" Content="Got it" Appearance="Primary"
                   HorizontalAlignment="Right" Height="36" Margin="0,12,0,0"
                   Click="BtnClose_Click" />
        </Grid>
    </Grid>
</ui:FluentWindow>
