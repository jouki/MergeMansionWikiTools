<ui:FluentWindow x:Class="MergeMansionWikiTools.Views.ChainNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Set Chain Name" Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Set Chain Display Name" Height="36" />

        <Grid Grid.Row="1" Margin="20,10,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Info -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock x:Name="txtConfigKey" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="txtCurrentName" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Margin="0,3,0,0" />
            </StackPanel>

            <!-- Name input -->
            <ui:TextBlock Grid.Row="1" Text="Chain name:" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                          FontSize="13" Margin="0,0,0,5" />
            <ui:TextBox x:Name="txtName" Grid.Row="2"
                        PlaceholderText="Enter display name..."
                        Margin="0,0,0,12"
                        KeyDown="TxtName_KeyDown" />

            <!-- Existing names list -->
            <Border Grid.Row="3" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <TextBlock Text="Previously used names (click to select)"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Top"
                               Margin="0,8,0,0" />

                    <ListView x:Name="lvExistingNames" Background="Transparent"
                              BorderThickness="0" Margin="0,26,0,0"
                              SelectionChanged="LvExistingNames_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12" Padding="6,3" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Buttons -->
            <Grid Grid.Row="4" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="1" Content="Skip"
                           Appearance="Secondary" Click="BtnSkip_Click"
                           Margin="0,0,8,0" Width="100" Height="36" />
                <ui:Button Grid.Column="2" Content="Confirm"
                           Appearance="Primary" Click="BtnConfirm_Click"
                           Width="100" Height="36" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
