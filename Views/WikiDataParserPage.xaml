<UserControl x:Class="MergeMansionWikiTools.Views.WikiDataParserPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <!-- Clickable path link style -->
        <Style x:Key="LinkStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="tb"
                                   Text="{TemplateBinding Content}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="540" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tb" Property="TextDecorations" Value="Underline"/>
                                <Setter TargetName="tb" Property="Foreground"
                                        Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Transparent icon button style (collapse toggles) -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:InfoBar x:Name="infoBar" Grid.Row="0"
                    IsOpen="False" IsClosable="True"
                    Margin="16,8,16,0" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel MaxWidth="900">

                <TextBlock Text="Wiki Data Parser" FontSize="28" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="4,0,0,24" />

                <!-- Toolbar card — two rows: Areas + Items -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Margin="0,0,0,16">
                    <StackPanel>

                        <!-- Areas row -->
                        <Grid Margin="16,10,16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Name="txtAreasStatus" FontSize="13"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Button x:Name="btnAreasPath"
                                        Style="{StaticResource LinkStyle}"
                                        Visibility="Collapsed"
                                        Click="BtnAreasPath_Click"
                                        ToolTip="Change Areas data file"
                                        ToolTipService.InitialShowDelay="0"
                                        Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:Button x:Name="btnGenerateAreas" Grid.Column="1"
                                       Content="Generate Areas"
                                       Appearance="Primary"
                                       Height="38" Padding="16,0"
                                       Click="BtnGenerateAreas_Click" />
                        </Grid>

                        <Separator Opacity="0.15" Margin="0" />

                        <!-- Items row -->
                        <Grid Margin="16,10,16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Name="txtItemsStatus" FontSize="13"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Button x:Name="btnItemsPath"
                                        Style="{StaticResource LinkStyle}"
                                        Visibility="Collapsed"
                                        Click="BtnItemsPath_Click"
                                        ToolTip="Change Items data file"
                                        ToolTipService.InitialShowDelay="0"
                                        Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:Button x:Name="btnGenerateItems" Grid.Column="1"
                                       Content="Generate Items"
                                       Appearance="Primary"
                                       Height="38" Padding="16,0"
                                       Click="BtnGenerateItems_Click" />
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- ── Areas section ─────────────────────────────────────── -->
                <StackPanel x:Name="areasSection" Visibility="Collapsed">

                    <!-- Section header -->
                    <Grid Margin="4,4,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="txtAreasHeader" Grid.Column="0"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <ui:SymbolIcon x:Name="iconAreasDateState" Grid.Column="1"
                                       Visibility="Collapsed"
                                       FontSize="20" VerticalAlignment="Center" Margin="8,0,0,0"
                                       ToolTipService.InitialShowDelay="0"
                                       ToolTipService.ShowOnDisabled="True" />
                        <ui:Button x:Name="btnUpdateWiki" Grid.Column="2"
                                   Appearance="Primary"
                                   Height="32" Padding="12,0"
                                   Click="BtnUpdateWiki_Click"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   ToolTipService.InitialShowDelay="0"
                                   ToolTipService.ShowOnDisabled="True">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="14" Margin="0,0,6,0"
                                              Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                <TextBlock Text="Update Wiki" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </StackPanel>
                        </ui:Button>
                        <Button x:Name="btnCollapseAreas" Grid.Column="3"
                                Style="{StaticResource IconButtonStyle}"
                                Click="BtnCollapseAreas_Click"
                                VerticalAlignment="Center" Margin="8,0,0,0">
                            <ui:SymbolIcon x:Name="iconCollapseAreas" Symbol="ChevronUp24" FontSize="16"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Button>
                    </Grid>

                    <!-- Collapsible content -->
                    <StackPanel x:Name="areasContent">
                        <StackPanel x:Name="chunksContainer" />
                    </StackPanel>

                </StackPanel>

                <!-- ── Items + Chain Names section ───────────────────────── -->
                <StackPanel x:Name="itemsSection" Visibility="Collapsed">

                    <!-- Section header -->
                    <Grid Margin="4,16,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Items + Chain Names" Grid.Column="0"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <ui:SymbolIcon x:Name="iconItemsDateState" Grid.Column="1"
                                       Visibility="Collapsed"
                                       FontSize="20" VerticalAlignment="Center" Margin="8,0,0,0"
                                       ToolTipService.InitialShowDelay="0"
                                       ToolTipService.ShowOnDisabled="True" />
                        <ui:Button x:Name="btnUpdateItemsWiki" Grid.Column="2"
                                   Appearance="Primary"
                                   Height="32" Padding="12,0"
                                   Click="BtnUpdateItemsWiki_Click"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   ToolTipService.InitialShowDelay="0"
                                   ToolTipService.ShowOnDisabled="True">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="14" Margin="0,0,6,0"
                                              Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                <TextBlock Text="Update Wiki" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </StackPanel>
                        </ui:Button>
                        <Button x:Name="btnCollapseItems" Grid.Column="3"
                                Style="{StaticResource IconButtonStyle}"
                                Click="BtnCollapseItems_Click"
                                VerticalAlignment="Center" Margin="8,0,0,0">
                            <ui:SymbolIcon x:Name="iconCollapseItems" Symbol="ChevronUp24" FontSize="16"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Button>
                    </Grid>

                    <!-- Collapsible content -->
                    <StackPanel x:Name="itemsContent">

                        <!-- Section header (shared across single/multi-chunk) -->
                        <TextBlock x:Name="txtCombinedHeader"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="4,0,0,8" />

                        <!-- Item chunk cards container (multi-chunk mode) -->
                        <StackPanel x:Name="itemChunksContainer" Visibility="Collapsed" />

                        <!-- Single combined card (single-module mode) -->
                        <Border x:Name="combinedCard"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <!-- Header row: Copy button + mini-loading -->
                                <Grid Margin="14,10,10,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="txtCombinedCardLabel" Grid.Column="0"
                                               Text="p.items + p.chainNames"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center" />

                                    <!-- Mini loading indicator (visible while full text loads) -->
                                    <StackPanel x:Name="combinedMiniLoading" Grid.Column="1"
                                                Orientation="Horizontal" VerticalAlignment="Center"
                                                Visibility="Collapsed" Margin="0,0,8,0">
                                        <TextBlock Text="Loading..." FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <ui:ProgressRing Width="12" Height="12"
                                                         IsIndeterminate="True"
                                                         Margin="4,0,0,0" />
                                    </StackPanel>

                                    <ui:Button x:Name="btnCopyCombined" Grid.Column="2"
                                               Content="Copy" Appearance="Secondary"
                                               Height="32" Padding="16,0"
                                               Click="BtnCopyCombined_Click" />
                                </Grid>

                                <!-- 2MB size warning (hidden by default) -->
                                <TextBlock x:Name="txtCombinedSizeWarning"
                                           Visibility="Collapsed"
                                           Margin="14,0,14,8"
                                           FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />

                                <Separator Opacity="0.15" Margin="0" />
                                <TextBox x:Name="txtCombined"
                                         IsReadOnly="True"
                                         TextWrapping="NoWrap"
                                         Height="220"
                                         FontFamily="Consolas" FontSize="11"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="12"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
