<UserControl x:Class="MergeMansionWikiTools.Views.AssetRipperPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:InfoBar x:Name="infoBar" Grid.Row="0"
                    IsOpen="False" IsClosable="True"
                    Margin="16,8,16,0" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel MaxWidth="800">

                <!-- Header -->
                <StackPanel Orientation="Horizontal" Margin="4,0,0,6">
                    <TextBlock Text="Asset Ripper" FontSize="28" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Border Background="{DynamicResource AccentFillColorSelectedTextBackgroundBrush}"
                            CornerRadius="4" Margin="10,6,0,6" Padding="8,2">
                        <TextBlock Text="Experimental" FontSize="11" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"
                           TextWrapping="Wrap" Margin="4,0,0,24">
                    <Run Text="Calls " /><Run Text="Asset Ripper CLI" FontWeight="SemiBold" /><Run Text=" to extract Unity bundle files. Requires Asset Ripper installed separately — " />
                    <Hyperlink NavigateUri="https://github.com/AssetRipper/AssetRipper/releases"
                               RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Text="github.com/AssetRipper/AssetRipper" />
                    </Hyperlink>
                    <Run Text="." />
                </TextBlock>

                <!-- ── Executable path ── -->
                <TextBlock Text="Asset Ripper Executable" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="4,0,0,10" />

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Margin="0,0,0,4">
                    <StackPanel Margin="16,14,16,12">
                        <TextBlock Text="Path to AssetRipper.CLI.exe" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="txtExePath"
                                        PlaceholderText="Browse to AssetRipper.CLI.exe..."
                                        IsReadOnly="True" AllowDrop="False" IsHitTestVisible="False"
                                        Margin="0,0,8,0" />
                            <ui:Button Grid.Column="1" Content="Browse" Appearance="Secondary"
                                       Click="BrowseExe_Click" Height="36" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12"
                           Margin="4,4,0,24">
                    <Run Text="Path is saved automatically." />
                </TextBlock>

                <!-- ── Extract ── -->
                <TextBlock Text="Extract" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="4,0,0,10" />

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Margin="0,0,0,16">
                    <StackPanel>

                        <!-- Input -->
                        <StackPanel Margin="16,14,16,12">
                            <TextBlock Text="Input" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Margin="0,0,0,4" />
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                                       Margin="0,0,0,8">
                                <Run Text="Bundle file or directory containing bundle files." />
                            </TextBlock>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox x:Name="txtInputPath"
                                            PlaceholderText="Select file or folder..."
                                            IsReadOnly="True" AllowDrop="False" IsHitTestVisible="False"
                                            Margin="0,0,8,0" />
                                <ui:Button Grid.Column="1" Content="File" Appearance="Secondary"
                                           Click="BrowseInputFile_Click" Margin="0,0,8,0" Height="36" />
                                <ui:Button Grid.Column="2" Content="Folder" Appearance="Secondary"
                                           Click="BrowseInputFolder_Click" Height="36" />
                            </Grid>
                        </StackPanel>

                        <Separator Opacity="0.15" Margin="0" />

                        <!-- Output -->
                        <StackPanel Margin="16,14,16,12">
                            <TextBlock Text="Output folder" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox x:Name="txtOutputPath"
                                            PlaceholderText="Select output folder..."
                                            IsReadOnly="True" AllowDrop="False" IsHitTestVisible="False"
                                            Margin="0,0,8,0" />
                                <ui:Button Grid.Column="1" Content="Browse" Appearance="Secondary"
                                           Click="BrowseOutput_Click" Height="36" />
                            </Grid>
                        </StackPanel>

                        <Separator Opacity="0.15" Margin="0" />

                        <!-- Extra args + Extract button -->
                        <Grid Margin="16,14,16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Additional arguments" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Margin="0,0,0,4" />
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                                           Margin="0,0,0,8">
                                    <Run Text="Optional CLI arguments appended after --input and --output." />
                                </TextBlock>
                                <ui:TextBox x:Name="txtExtraArgs"
                                            PlaceholderText="e.g. --log-level Verbose" />
                            </StackPanel>
                            <ui:Button x:Name="btnExtract" Grid.Column="1"
                                       Content="Extract" Appearance="Primary"
                                       Height="38" Padding="20,0"
                                       VerticalAlignment="Bottom"
                                       Click="BtnExtract_Click" />
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- ── Log output ── -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Output log" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="4,0,0,0" VerticalAlignment="Center" />
                    <ui:Button Grid.Column="1" x:Name="btnClearLog" Content="Clear"
                               Appearance="Secondary" Height="30" Padding="14,0"
                               Click="BtnClearLog_Click" />
                </Grid>

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <TextBox x:Name="txtLog"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             Height="280"
                             FontFamily="Consolas" FontSize="11"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="12"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" />
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
