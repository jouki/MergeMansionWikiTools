<UserControl x:Class="MergeMansionWikiTools.Views.MysteriesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel MaxWidth="1000">

                <TextBlock Text="Mysteries" FontSize="28" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="4,0,0,20" />

                <!-- Toolbar: Search + actions -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBox x:Name="txtSearch" Grid.Column="0"
                                PlaceholderText="Search mysteries..."
                                TextChanged="TxtSearch_TextChanged"
                                Margin="0,0,10,0"
                                Icon="{ui:SymbolIcon Search24}" />

                    <ui:Button x:Name="btnRefresh" Grid.Column="1"
                               Content="Refresh" Appearance="Secondary"
                               Click="BtnRefresh_Click" Height="36"
                               Margin="0,0,8,0" />

                    <ui:Button x:Name="btnCheckWiki" Grid.Column="2"
                               Content="Check Wiki Status" Appearance="Primary"
                               Click="BtnCheckWiki_Click" Height="36" />
                </Grid>

                <!-- Summary -->
                <TextBlock x:Name="txtSummary" FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Margin="4,0,0,16" />

                <!-- Mystery list -->
                <StackPanel x:Name="mysteryListPanel" />

                <!-- Empty state -->
                <StackPanel x:Name="emptyState" Visibility="Collapsed" Margin="4,20,0,0">
                    <TextBlock FontSize="13"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                        <Run Text="No events.json loaded." />
                    </TextBlock>
                    <TextBlock FontSize="13" Margin="0,4,0,0">
                        <Hyperlink Click="GoToSettings_Click">
                            <Run Text="Set the path in Settings" />
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- InfoBar at bottom -->
        <ui:InfoBar x:Name="infoBar" Grid.Row="1" IsOpen="False"
                    IsClosable="True" Margin="10,0,10,10" />
    </Grid>
</UserControl>
