<UserControl x:Class="MergeMansionWikiTools.Views.MysteriesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Fixed header (stays visible while scrolling) -->
        <StackPanel Grid.Row="0" MaxWidth="1000" HorizontalAlignment="Stretch" Margin="24,16,24,0">

            <TextBlock Text="Mysteries" FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="4,0,0,20" />

            <!-- AB bucket selector — when set, loads patched events.json from <DumpFolder>/<bucket>/ -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="AB experiment bucket:" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="4,0,8,0" FontSize="12" />
                <ComboBox x:Name="cmbBucket" Grid.Column="1"
                          SelectionChanged="CmbBucket_SelectionChanged"
                          HorizontalAlignment="Stretch" />
            </Grid>

            <!-- Toolbar: Search + actions -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBox x:Name="txtSearch" Grid.Column="0"
                            PlaceholderText="Search mysteries..."
                            TextChanged="TxtSearch_TextChanged"
                            Margin="0,0,10,0"
                            Icon="{ui:SymbolIcon Search24}" />

                <ui:Button x:Name="btnRefresh" Grid.Column="1"
                           Content="Refresh" Appearance="Secondary"
                           Click="BtnRefresh_Click" Height="36"
                           Margin="0,0,8,0" />

                <ui:Button x:Name="btnCheckWiki" Grid.Column="2"
                           Content="Check Wiki Status" Appearance="Primary"
                           Click="BtnCheckWiki_Click" Height="36" />
            </Grid>

            <ProgressBar x:Name="checkWikiProgress"
                         IsIndeterminate="True" Visibility="Collapsed"
                         Height="3" Margin="4,-8,4,4" />

            <!-- Summary -->
            <TextBlock x:Name="txtSummary" FontSize="12"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Margin="4,0,0,12" />

        </StackPanel>

        <!-- Scrollable mystery list -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1000" Margin="24,0,24,16">

                <!-- Mystery list -->
                <StackPanel x:Name="mysteryListPanel" />

                <!-- Empty state -->
                <StackPanel x:Name="emptyState" Visibility="Collapsed" Margin="4,20,0,0">
                    <TextBlock Text="No events.json loaded." FontSize="13"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ui:Button Content="Go to Settings" Appearance="Secondary" Margin="0,8,0,0"
                               Height="34" Click="GoToSettings_Click" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- InfoBar at bottom -->
        <ui:InfoBar x:Name="infoBar" Grid.Row="2" IsOpen="False"
                    IsClosable="True" Margin="10,0,10,10" />
    </Grid>
</UserControl>
