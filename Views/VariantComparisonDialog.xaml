<ui:FluentWindow x:Class="MergeMansionWikiTools.Views.VariantComparisonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Compare AB Test Variants" Height="720" Width="850"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Height="36">
            <ui:TitleBar.Header>
                <TextBlock Text="{Binding DialogTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="24,10,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Chain info header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock x:Name="txtChainInfo" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="txtChainDetail" FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Margin="0,3,0,0" />
            </StackPanel>

            <!-- Variant list -->
            <TextBlock x:Name="txtVariants" Grid.Row="1" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,10" TextWrapping="Wrap" />

            <!-- Content area -->
            <Grid Grid.Row="2">
                <!-- Loading indicator -->
                <StackPanel x:Name="pnlLoading" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40" />
                    <TextBlock Text="Comparing variants..." FontSize="13" Margin="0,12,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Results -->
                <ScrollViewer x:Name="scrollResults" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="pnlResults" Margin="0,0,10,0" />
                </ScrollViewer>

                <!-- No differences message -->
                <StackPanel x:Name="pnlNoDiffs" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="Checkmark24" FontSize="36"
                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                    <TextBlock Text="No differences found" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,4" />
                    <TextBlock Text="All variant values match the main group." FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Error message -->
                <StackPanel x:Name="pnlError" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="36"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    <TextBlock x:Name="txtError" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,0"
                               TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Bottom buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <ui:Button Content="Close" Appearance="Primary" Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
