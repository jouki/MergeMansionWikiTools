<ui:FluentWindow x:Class="MergeMansionWikiTools.Views.GameUpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="New Game Version"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- TitleBar -->
            <RowDefinition Height="Auto" />  <!-- Header -->
            <RowDefinition Height="Auto" />  <!-- Version info -->
            <RowDefinition Height="Auto" />  <!-- APK option -->
            <RowDefinition Height="Auto" />  <!-- Progress -->
            <RowDefinition Height="Auto" />  <!-- Result -->
            <RowDefinition Height="Auto" />  <!-- Buttons -->
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" ShowMinimize="False" ShowMaximize="False" ShowClose="True" />

        <!-- Header -->
        <StackPanel Grid.Row="1" Margin="24,0,24,16" Orientation="Horizontal">
            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="24" Margin="0,0,10,0"
                           Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
            <TextBlock Text="A new game version is available!"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </StackPanel>

        <!-- Version info -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8" Padding="16,12" Margin="24,0,24,12"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="Current" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="txtCurrentVersion" Text="" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <ui:SymbolIcon Grid.Column="1" Symbol="ArrowRight24" FontSize="18" Margin="16,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="New" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="txtNewVersion" Text="" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="txtReleaseDate" Text="" FontSize="11" Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Border>

        <!-- APK option -->
        <StackPanel Grid.Row="3" Margin="24,0,24,12">
            <CheckBox x:Name="chkDownloadApk" Content="Download APK (~200 MB)" IsChecked="True" />
            <TextBlock x:Name="txtApkNote" Text="" FontSize="11" Margin="28,2,0,0"
                       Visibility="Collapsed" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>

        <!-- Progress (hidden by default) -->
        <StackPanel x:Name="progressPanel" Grid.Row="4" Margin="24,0,24,12" Visibility="Collapsed">
            <ProgressBar x:Name="progressBar" Height="6" IsIndeterminate="True" />
            <TextBlock x:Name="txtProgress" Text="" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Result (hidden by default) -->
        <TextBlock x:Name="txtResult" Grid.Row="5" Margin="24,0,24,12" Visibility="Collapsed"
                   FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="24,0,24,20">
            <ui:Button x:Name="btnLater" Content="Later" Appearance="Secondary"
                       Height="34" Padding="20,0" Margin="0,0,8,0" Click="BtnLater_Click" />
            <ui:Button x:Name="btnSkip" Content="Skip this version" Appearance="Secondary"
                       Height="34" Padding="20,0" Margin="0,0,8,0" Click="BtnSkip_Click" />
            <ui:Button x:Name="btnUpdate" Content="Update" Appearance="Primary"
                       Height="34" Padding="20,0" Click="BtnUpdate_Click" />
            <ui:Button x:Name="btnOpenDumper" Content="Open Game Data Dumper" Appearance="Primary"
                       Height="34" Padding="20,0" Margin="0,0,8,0" Visibility="Collapsed"
                       Click="BtnOpenDumper_Click" />
            <ui:Button x:Name="btnClose" Content="Close" Appearance="Secondary"
                       Height="34" Padding="20,0" Visibility="Collapsed" Click="BtnClose_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
