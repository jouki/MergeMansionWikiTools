<ui:FluentWindow x:Class="MergeMansionWikiTools.Views.TableGeneratorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Generate Item Table" Height="750" Width="900"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Generate Item Table" Height="36" />

        <Grid Grid.Row="1" Margin="24,10,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Chain info -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock x:Name="txtChainInfo" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="txtChainDetail" FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Margin="0,3,0,0" />
            </StackPanel>

            <!-- Options panel -->
            <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="4" Padding="16,14"
                    Margin="0,0,0,12"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Options" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <CheckBox x:Name="chkHardcodeName" Content="Hardcode name"
                                      ToolTip="Use hardcoded chain name instead of {{PAGENAME}} in table caption"
                                      ToolTipService.InitialShowDelay="150"
                                      Checked="ChkOption_Changed" Unchecked="ChkOption_Changed" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <CheckBox x:Name="chkLowPrices" Content="Low Prices"
                                      ToolTip="Sets all item prices in chain to 1 Coin (for Event Items)"
                                      ToolTipService.InitialShowDelay="150"
                                      Checked="ChkOption_Changed" Unchecked="ChkOption_Changed" />
                            <CheckBox x:Name="chkIncludeHeading" Content="Include wiki heading"
                                      Margin="0,4,0,0"
                                      ToolTip="Prepends == Statistics == and === Merge Stages === above the table"
                                      Checked="ChkOption_Changed" Unchecked="ChkOption_Changed" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Source group selector (visible when chain has level collisions from merged sources) -->
            <Border x:Name="sourceGroupPanel" Grid.Row="2" Visibility="Collapsed"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="4" Padding="16,10"
                    Margin="0,0,0,12"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Source group:" VerticalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,12,0"/>
                    <ComboBox x:Name="cmbSourceGroup" Grid.Column="1"
                              Height="36" VerticalAlignment="Center"
                              SelectionChanged="CmbSourceGroup_SelectionChanged"/>
                </Grid>
            </Border>


            <!-- Output area -->
            <Border Grid.Row="4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="4"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <TextBlock x:Name="txtOutputPlaceholder"
                               Text="Generated table will appear here"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <TextBox x:Name="txtOutput"
                             Background="Transparent"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             BorderThickness="0" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="12"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Padding="12,10"
                             Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- Bottom buttons + status -->
            <Grid Grid.Row="5" Margin="0,12,0,0" MinHeight="50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:InfoBar x:Name="warningBar" Grid.Column="0" IsOpen="False"
                            IsClosable="True" VerticalAlignment="Stretch"
                            Margin="0,0,12,0" />

                <ui:Button Grid.Column="1" Content="Copy to Clipboard"
                           x:Name="btnCopy"
                           Appearance="Secondary" Click="BtnCopy_Click"
                           VerticalAlignment="Stretch"
                           Margin="0,1,8,2" IsEnabled="False" />
                <ui:Button Grid.Column="2" Content="Close"
                           Appearance="Secondary" Click="BtnClose_Click"
                           VerticalAlignment="Stretch"
                           Margin="0,1,0,2" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
