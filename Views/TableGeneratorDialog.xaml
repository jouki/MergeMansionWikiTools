<ui:FluentWindow x:Class="MergeMansionWikiTools.Views.TableGeneratorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Generate Item Table" Height="750" Width="900"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Generate Item Table" Height="36" />

        <Grid Grid.Row="1" Margin="24,10,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Chain info -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock x:Name="txtChainInfo" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="txtChainDetail" FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Margin="0,3,0,0" />
            </StackPanel>

            <!-- Options panel -->
            <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="4" Padding="16,14"
                    Margin="0,0,0,12"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Options" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <CheckBox x:Name="chkShowNamePrompt" Content="Show custom name prompt"
                                      Checked="ChkShowNamePrompt_Changed"
                                      Unchecked="ChkShowNamePrompt_Changed" />
                            <CheckBox x:Name="chkForceNamePrompt" Content="Force prompt always"
                                      Margin="24,4,0,0"
                                      IsEnabled="{Binding IsChecked, ElementName=chkShowNamePrompt}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <CheckBox x:Name="chkLowPrices">
                                <CheckBox.Content>
                                    <TextBlock Text="Low Prices"
                                               ToolTip="Low Prices sets all prices in chain to 1 Coin (Event Items)" />
                                </CheckBox.Content>
                            </CheckBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Existing table input -->
            <Expander Grid.Row="2" Header="Paste existing table (for Speed Up Cost)" Margin="0,0,0,12"
                      IsExpanded="False">
                <ui:TextBox x:Name="txtExistingTable"
                            PlaceholderText="Paste existing wiki table here to extract Speed Up Cost values..."
                            AcceptsReturn="True" TextWrapping="Wrap"
                            MinHeight="80" MaxHeight="150"
                            VerticalContentAlignment="Top"
                            Margin="0,8,0,0" />
            </Expander>

            <!-- Generate button -->
            <ui:Button Grid.Row="3" Content="Generate Table"
                       Appearance="Primary" Height="42"
                       HorizontalAlignment="Stretch"
                       Click="BtnGenerate_Click" Margin="0,0,0,12" />

            <!-- Output area -->
            <Border Grid.Row="4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="4"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <TextBlock x:Name="txtOutputPlaceholder"
                               Text="Generated table will appear here"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <TextBox x:Name="txtOutput"
                             Background="Transparent"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             BorderThickness="0" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="12"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Padding="12,10"
                             Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- Warnings -->
            <ui:InfoBar x:Name="warningBar" Grid.Row="5" IsOpen="False"
                        IsClosable="True" Margin="0,8,0,0" />

            <!-- Bottom buttons -->
            <Grid Grid.Row="6" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="1" Content="Copy to Clipboard"
                           x:Name="btnCopy"
                           Appearance="Secondary" Click="BtnCopy_Click"
                           Margin="0,0,8,0" Height="38" IsEnabled="False" />
                <ui:Button Grid.Column="2" Content="Close"
                           Appearance="Secondary" Click="BtnClose_Click" Height="38" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
