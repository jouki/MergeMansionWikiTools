<UserControl x:Class="MergeMansionWikiTools.Views.ChainBrowserPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title row -->
        <Grid Grid.Row="0" Margin="4,0,4,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Item Chains" FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="txtChainCount" Grid.Column="1"
                       VerticalAlignment="Bottom" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="13" />
        </Grid>

        <!-- Search and filter bar -->
        <Grid Grid.Row="1" Margin="4,0,4,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox x:Name="txtSearch" Grid.Column="0"
                        PlaceholderText="Search chains..."
                        TextChanged="TxtSearch_TextChanged"
                        Margin="0,0,10,0"
                        Icon="{ui:SymbolIcon Search24}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="chkGenerators" Content="Generators"
                          Checked="ChkFilter_Changed" Unchecked="ChkFilter_Changed" Margin="0,0,8,0" />
                <CheckBox x:Name="chkSpawners" Content="Spawners"
                          Checked="ChkFilter_Changed" Unchecked="ChkFilter_Changed" Margin="0,0,8,0" />
                <CheckBox x:Name="chkProducts" Content="Products"
                          Checked="ChkFilter_Changed" Unchecked="ChkFilter_Changed" Margin="0,0,8,0" />
                <CheckBox x:Name="chkEvent" Content="Event"
                          Checked="ChkFilter_Changed" Unchecked="ChkFilter_Changed" Margin="0,0,8,0" />
                <CheckBox x:Name="chkNamed" Content="Named"
                          Checked="ChkFilter_Changed" Unchecked="ChkFilter_Changed" />
            </StackPanel>
        </Grid>

        <!-- Chain list -->
        <Grid Grid.Row="2">
            <!-- Empty state -->
            <StackPanel x:Name="emptyState" VerticalAlignment="Center"
                        HorizontalAlignment="Center" Visibility="Visible">
                <TextBlock Text="No data loaded" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Go to Settings to load chain_item_odds.json"
                           HorizontalAlignment="Center" FontSize="12" Margin="0,5,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>

            <!-- Chain list -->
            <ListView x:Name="lvChains" BorderThickness="0"
                      Background="Transparent"
                      Visibility="Collapsed"
                      Padding="0,0,0,0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="4"
                                Margin="0,0,12,3" Padding="10,0,16,0"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Expander IsExpanded="False" Background="Transparent"
                                      BorderThickness="0" Padding="0"
                                      HorizontalContentAlignment="Stretch"
                                      HorizontalAlignment="Stretch">
                                <Expander.Header>
                                    <Grid HorizontalAlignment="Stretch"
                                          Margin="0,6,10,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Chain name + ConfigKey -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <!-- DisplayName with search highlighting via Loaded event -->
                                            <TextBlock x:Name="txtDisplayName"
                                                       Text="{Binding DisplayName}"
                                                       Foreground="#EEEEEE" FontSize="14"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Tag="{Binding}"
                                                       Loaded="TxtDisplayName_Loaded" />
                                            <TextBlock Text="{Binding ConfigKey}"
                                                       Foreground="#666666" FontSize="11"
                                                       Visibility="{Binding ShowConfigKey,
                                                           Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>

                                        <!-- Summary badge -->
                                        <Border Grid.Column="1" Background="#1E1E1E"
                                                CornerRadius="4" Padding="8,3"
                                                VerticalAlignment="Center" Margin="10,0">
                                            <TextBlock Text="{Binding Summary}"
                                                       Foreground="#999999" FontSize="11" />
                                        </Border>

                                        <!-- Action button -->
                                        <ui:Button Grid.Column="2" Content="Generate Table"
                                                   Appearance="Primary" FontSize="12"
                                                   Height="30" Padding="12,0"
                                                   Click="GenerateTable_Click"
                                                   Tag="{Binding}" />
                                    </Grid>
                                </Expander.Header>

                                <!-- Expanded: item list -->
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        Padding="16,8,16,12">
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="35" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding Level, StringFormat='Lv{0}'}"
                                                               Foreground="#777777" FontSize="12"
                                                               FontFamily="Consolas"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Name}"
                                                               Foreground="#BBBBBB" FontSize="12"
                                                               VerticalAlignment="Center"
                                                               Tag="{Binding}"
                                                               Loaded="TxtItemName_Loaded" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding TypeBadge}"
                                                               Foreground="#B0B0B0" FontSize="9"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               Padding="0,0,4,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Expander>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
