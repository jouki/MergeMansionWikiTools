<ui:FluentWindow x:Class="MergeMansionWikiTools.Views.MysteryGeneratorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:MergeMansionWikiTools.Views"
        Title="Prepare" Height="900" Width="1100"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Prepare" Height="36" />

        <Grid Grid.Row="1" Margin="24,10,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Mystery info -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock x:Name="txtMysteryInfo" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="txtMysteryDetail" FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Margin="0,3,0,0" />
            </StackPanel>

            <!-- Mode tabs -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <ListBox x:Name="tabMode" Background="Transparent" BorderThickness="0"
                         SelectedIndex="0" SelectionChanged="TabMode_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,8" />
                            <Setter Property="Margin" Value="0,0,4,0" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" CornerRadius="4"
                                                Padding="{TemplateBinding Padding}" Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBoxItem>
                        <TextBlock Text="Event Page" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </ListBoxItem>
                    <ListBoxItem>
                        <TextBlock Text="Rewards" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </ListBoxItem>
                    <ListBoxItem>
                        <TextBlock Text="Event Item Page" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </ListBoxItem>
                    <ListBoxItem>
                        <TextBlock Text="Images" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- Content area -->
            <Grid Grid.Row="2">
                <!-- Generated text output (Rewards, or Event/Item Page when no diff) -->
                <Border x:Name="pnlOutput"
                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="4"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <TextBlock x:Name="txtOutputPlaceholder"
                                   Text="Generated wikitext will appear here"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <TextBox x:Name="txtOutput"
                                 Background="Transparent"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                 BorderThickness="0" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="12"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Padding="12,10"
                                 Visibility="Collapsed" />
                    </Grid>
                </Border>

                <!-- Diff view (Event/Item Page when page exists on wiki) -->
                <Grid x:Name="pnlDiff" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Column headers -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="txtDiffLeftHeader" Grid.Column="0" FontSize="12" Margin="4,0,0,0">
                            <Run Text="Wiki (current)" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Run x:Name="runDiffLeftSuffix" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </TextBlock>
                        <TextBlock x:Name="txtDiffRightHeader" Grid.Column="2" FontSize="12" Margin="4,0,0,0">
                            <Run Text="Generated (new)" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Run x:Name="runDiffRightSuffix" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </TextBlock>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" CornerRadius="4,0,0,4" BorderThickness="1,1,0,1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                            <ScrollViewer x:Name="scrollLeft" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto"
                                          ScrollChanged="ScrollLeft_ScrollChanged">
                                <StackPanel x:Name="pnlLeft" Margin="8,6,8,6"
                                            MouseLeftButtonUp="PnlLeft_MouseUp" />
                            </ScrollViewer>
                        </Border>

                        <ScrollViewer Grid.Column="1" x:Name="scrollCenter"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled"
                                      ScrollChanged="ScrollCenter_ScrollChanged">
                            <StackPanel x:Name="pnlCenter" />
                        </ScrollViewer>

                        <Border Grid.Column="2" CornerRadius="0,4,4,0" BorderThickness="0,1,1,1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                            <ScrollViewer x:Name="scrollRight" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto"
                                          ScrollChanged="ScrollRight_ScrollChanged">
                                <StackPanel x:Name="pnlRight" Margin="8,6,8,6"
                                            MouseLeftButtonUp="PnlRight_MouseUp" />
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- Loading overlay for diff -->
                    <StackPanel x:Name="pnlDiffLoading" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Grid.RowSpan="2" Visibility="Collapsed">
                        <ui:ProgressRing IsIndeterminate="True" Width="36" Height="36" />
                        <TextBlock Text="Fetching wiki content..." FontSize="12" Margin="0,10,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Images tab — full embedded control -->
                <local:MysteryImagesControl x:Name="imagesControl" Visibility="Collapsed" />
            </Grid>

            <!-- Bottom buttons + status -->
            <Grid Grid.Row="3" Margin="0,12,0,0" MinHeight="50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:InfoBar x:Name="warningBar" Grid.Column="0" IsOpen="False"
                            IsClosable="True" VerticalAlignment="Stretch"
                            Margin="0,0,12,0" />

                <ui:Button x:Name="btnConfirmManual" Grid.Column="1"
                           Content="Confirm as Correct"
                           Appearance="Secondary" Click="BtnConfirmManual_Click"
                           VerticalAlignment="Stretch"
                           Margin="0,1,8,2" Visibility="Collapsed"
                           ToolTip="Manually confirm this section as correct despite data mismatch"
                           ToolTipService.InitialShowDelay="0" />
                <ui:Button x:Name="btnPublish" Grid.Column="2"
                           Content="Publish to Wiki"
                           Appearance="Primary" Click="BtnPublish_Click"
                           VerticalAlignment="Stretch"
                           Margin="0,1,8,2" Visibility="Collapsed" />
                <ui:Button Grid.Column="3" Content="Copy to Clipboard"
                           x:Name="btnCopy"
                           Appearance="Secondary" Click="BtnCopy_Click"
                           VerticalAlignment="Stretch"
                           Margin="0,1,8,2" IsEnabled="False" />
                <ui:Button Grid.Column="4" Content="Close"
                           Appearance="Secondary" Click="BtnClose_Click"
                           VerticalAlignment="Stretch"
                           Margin="0,1,0,2" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
