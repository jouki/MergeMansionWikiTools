<ui:FluentWindow x:Class="MergeMansionWikiTools.Views.UploadConflictDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Upload Conflict" Height="330" Width="620"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
    ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <DrawingBrush x:Key="CheckerBrush" TileMode="Tile"
                      Viewport="0,0,16,16" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#22808080">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,16,16"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#33808080">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8"/>
                                <RectangleGeometry Rect="8,8,8,8"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="dialogTitleBar" Title="Upload Conflict" Height="36"/>

        <Grid Grid.Row="1" Margin="20,10,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Message -->
            <StackPanel>
                <TextBlock x:Name="txtMessage" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13"/>
                <TextBlock x:Name="txtRemaining" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12"/>
            </StackPanel>

            <!-- Image comparison: Old (wiki) vs New (local) -->
            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="colOld" Width="*"/>
                    <ColumnDefinition x:Name="colArrow" Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Old (wiki) — hidden in single-preview modes -->
                <Border x:Name="pnlOld"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="6" Padding="6"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Old (wiki)" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <Grid Grid.Row="1">
                            <Border Background="{StaticResource CheckerBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image x:Name="imgOld" MaxHeight="100" MaxWidth="220"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Stretch="Uniform"/>
                            </Border>
                            <ui:ProgressRing x:Name="ringOld"
                                             Width="24" Height="24" IsIndeterminate="True"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="txtOldMeta" Grid.Row="2" FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <TextBlock x:Name="txtOldAuthor" Grid.Row="3" FontSize="10"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </Grid>
                </Border>

                <!-- Arrow -->
                <ui:SymbolIcon x:Name="iconArrow" Grid.Column="1" Symbol="ArrowRight24"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               FontSize="20" Margin="12,14,12,0" VerticalAlignment="Center"/>

                <!-- New (local) -->
                <Border Grid.Column="2"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="6" Padding="6"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="txtNewLabel" Text="New (local)" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <Grid Grid.Row="1">
                            <Border Background="{StaticResource CheckerBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image x:Name="imgNew" MaxHeight="100" MaxWidth="220"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Stretch="Uniform"/>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="txtNewMeta" Grid.Row="2" FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <TextBlock x:Name="txtNewAuthor" Grid.Row="3" FontSize="10"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Buttons: conflict mode -->
            <Grid x:Name="pnlConflictButtons" Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="0" Content="Force upload"
                           Appearance="Primary" Click="BtnForce_Click"
                           Height="36" Padding="14,0" Margin="0,0,6,0"/>
                <ui:Button Grid.Column="1" Content="Force upload (all)"
                           Appearance="Primary" Click="BtnForceAll_Click"
                           Height="36" Padding="14,0"/>

                <ui:Button Grid.Column="3" Content="Skip"
                           Appearance="Secondary" Click="BtnSkip_Click"
                           Height="36" Padding="14,0" Margin="0,0,6,0"/>
                <ui:Button Grid.Column="4" Content="Skip (all)"
                           Appearance="Secondary" Click="BtnSkipAll_Click"
                           Height="36" Padding="14,0" Margin="0,0,6,0"/>
                <ui:Button Grid.Column="5" Content="Cancel"
                           Appearance="Secondary" Click="BtnCancel_Click"
                           Height="36" Padding="14,0"/>
            </Grid>

            <!-- Buttons: confirm/optimize mode (single preview) -->
            <Grid x:Name="pnlConfirmButtons" Grid.Row="2" Margin="0,16,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:Button x:Name="btnConfirm" Grid.Column="0"
                           Content="Upload"
                           Appearance="Primary" Click="BtnForce_Click"
                           Height="36" Padding="14,0" Margin="0,0,6,0"/>
                <ui:Button x:Name="btnConfirmAll" Grid.Column="1"
                           Content="Upload All"
                           Appearance="Primary" Click="BtnForceAll_Click"
                           Height="36" Padding="14,0" Margin="0,0,6,0"
                           ToolTip="All already optimized images will be uploaded."
                           ToolTipService.InitialShowDelay="0"/>
                <ui:Button x:Name="btnConfirmAllForce" Grid.Column="2"
                           Content="Upload All (Force)"
                           Appearance="Primary" Click="BtnForceAllOptimize_Click"
                           Height="36" Padding="14,0" Visibility="Collapsed"
                           ToolTip="All selected images that haven't been optimized will be optimized via TinyPNG and uploaded to the wiki."
                           ToolTipService.InitialShowDelay="0"/>
                <ui:Button Grid.Column="4" Content="Cancel"
                           Appearance="Secondary" Click="BtnCancel_Click"
                           Height="36" Padding="14,0"/>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
