<ui:FluentWindow x:Class="MergeMansionWikiTools.Views.UploadConflictDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Upload Conflict" Height="240" Width="620"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
    ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Upload Conflict" Height="36"/>

        <Grid Grid.Row="1" Margin="20,10,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Content: image preview + message -->
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="6" Padding="6" Margin="0,0,16,0"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Image x:Name="imgPreview" Width="80" Height="80"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="txtMessage" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13"/>
                    <TextBlock x:Name="txtRemaining" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12"/>
                </StackPanel>
            </Grid>

            <!-- Buttons -->
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="0" Content="Force upload"
                           Appearance="Primary" Click="BtnForce_Click"
                           Height="36" Padding="14,0" Margin="0,0,6,0"/>
                <ui:Button Grid.Column="1" Content="Force upload (all)"
                           Appearance="Primary" Click="BtnForceAll_Click"
                           Height="36" Padding="14,0"/>

                <ui:Button Grid.Column="3" Content="Skip"
                           Appearance="Secondary" Click="BtnSkip_Click"
                           Height="36" Padding="14,0" Margin="0,0,6,0"/>
                <ui:Button Grid.Column="4" Content="Skip (all)"
                           Appearance="Secondary" Click="BtnSkipAll_Click"
                           Height="36" Padding="14,0" Margin="0,0,6,0"/>
                <ui:Button Grid.Column="5" Content="Cancel"
                           Appearance="Secondary" Click="BtnCancel_Click"
                           Height="36" Padding="14,0"/>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
