<ui:FluentWindow x:Class="MergeMansionWikiTools.Views.InfoboxGeneratorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Generate Infobox" Height="820" Width="750"
        MinWidth="600" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Generate Infobox" Height="36" />

        <Grid Grid.Row="1" Margin="24,10,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Chain info -->
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="txtChainInfo" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Border Background="#B45309" CornerRadius="4"
                            Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Experimental" FontSize="10" FontWeight="SemiBold"
                                   Foreground="White" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="txtChainDetail" FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Margin="0,3,0,0" />
            </StackPanel>

            <!-- Options -->
            <Border Grid.Row="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="4" Padding="16,12"
                    Margin="0,0,0,10"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Options" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <CheckBox x:Name="chkAddShop" Content="Add Shop as Source"
                                      Checked="ChkOption_Changed" Unchecked="ChkOption_Changed" />
                            <CheckBox x:Name="chkIsStarter" Content="Starter Item"
                                      Margin="0,5,0,0"
                                      Checked="ChkOption_Changed" Unchecked="ChkOption_Changed" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <CheckBox x:Name="chkIsPoints" Content="Points Item"
                                      Checked="ChkOption_Changed" Unchecked="ChkOption_Changed" />
                            <CheckBox x:Name="chkIsDepleting" Content="Depleting Item (override)"
                                      Margin="0,5,0,0"
                                      ToolTip="Force-adds Depleting Item type even if not auto-detected from JSON"
                                      ToolTipService.InitialShowDelay="150"
                                      Checked="ChkOption_Changed" Unchecked="ChkOption_Changed" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Sources -->
            <Expander Grid.Row="2" Header="Sources (one per line)"
                      IsExpanded="True" Margin="0,0,0,10">
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Auto-detected from other chains — edit as needed."
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="0,0,0,5" />
                    <ui:TextBox x:Name="txtSources"
                                AcceptsReturn="True" TextWrapping="NoWrap"
                                MinHeight="60" MaxHeight="120"
                                VerticalContentAlignment="Top"
                                FontFamily="Consolas" FontSize="12"
                                TextChanged="TxtSources_TextChanged" />
                </StackPanel>
            </Expander>

            <!-- Preview -->
            <Border Grid.Row="3"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="4"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <TextBlock x:Name="txtOutputPlaceholder"
                               Text="Infobox preview will appear here"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBox x:Name="txtOutput"
                             Background="Transparent"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             BorderThickness="0" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="12"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Padding="12,10"
                             Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- Bottom bar -->
            <Grid Grid.Row="4" Margin="0,12,0,0" MinHeight="50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:InfoBar x:Name="infoBar" Grid.Column="0" IsOpen="False"
                            IsClosable="True" VerticalAlignment="Stretch"
                            Margin="0,0,12,0" />

                <ui:Button Grid.Column="1" x:Name="btnCopy"
                           Content="Copy to Clipboard"
                           Appearance="Secondary" Click="BtnCopy_Click"
                           VerticalAlignment="Stretch"
                           Margin="0,1,8,2" IsEnabled="False" />
                <ui:Button Grid.Column="2" Content="Close"
                           Appearance="Secondary" Click="BtnClose_Click"
                           VerticalAlignment="Stretch"
                           Margin="0,1,0,2" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
