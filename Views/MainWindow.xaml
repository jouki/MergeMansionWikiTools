<ui:FluentWindow x:Class="MergeMansionWikiTools.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:MergeMansionWikiTools.Views"
        Title="Merge Mansion Wiki Tools" Height="963" Width="1380"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/AppLogo.ico"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="Merge Mansion Wiki Tools" Height="42" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="275" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar navigation -->
            <Border Grid.Column="0" Padding="12,8,12,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- App title in sidebar -->
                    <Grid Grid.Row="0" Margin="8,4,8,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="/Assets/AppLogo.ico"
                               Width="42" Height="42" Margin="0,0,10,0"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="MM Wiki Tools" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="txtDataStatus" Text="No data loaded"
                                       FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Nav buttons - Windows Settings style (ListBox with custom template) -->
                    <Grid Grid.Row="1">
                        <ListBox x:Name="navList"
                                 Background="Transparent" BorderThickness="0"
                                 SelectionChanged="NavList_SelectionChanged"
                                 SelectedIndex="0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="12,12" />
                                    <Setter Property="Margin" Value="0,3" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}" Background="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background"
                                                                Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background"
                                                                Value="{DynamicResource SidebarItemSelectedBackground}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="List24" FontSize="22" Margin="0,0,12,0"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Item Chains" FontSize="14" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Padding="12,4">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Assets/ImageSplitterIcon.ico" Width="42" Height="42" Margin="0,0,12,0"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="Image Optimiser" FontSize="14" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ChatMultiple24" FontSize="22" Margin="0,0,12,0"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Dialogue Maker" FontSize="14" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="DocumentTable24" FontSize="22" Margin="0,0,12,0"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Wiki Data Parser" FontSize="14" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ImageMultiple24" FontSize="22" Margin="0,0,12,0"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Image Extractor" FontSize="14" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Trophy24" FontSize="22" Margin="0,0,12,0"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Mysteries" FontSize="14" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="DatabaseArrowDown20" FontSize="22" Margin="0,0,12,0"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Game Data Dumper" FontSize="14" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="FlowchartCircle24" FontSize="22" Margin="0,0,12,0"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Area Flowcharts" FontSize="14" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Settings24" FontSize="22" Margin="0,0,12,0"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Settings" FontSize="14" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Info24" FontSize="22" Margin="0,0,12,0"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="About" FontSize="14" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>

                        <!-- Selection accent indicator (animated) -->
                        <Border x:Name="navIndicator"
                                Width="3" Height="16"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                CornerRadius="1.5"
                                IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="navIndicatorTransform" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>

                    <!-- Version info -->
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock x:Name="txtSidebarVersion" FontSize="10"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="by Jouki" FontSize="10"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ContentControl x:Name="contentArea" Grid.Row="0" />

                <!-- Status bar -->
                <ui:InfoBar x:Name="statusBar" Grid.Row="1" IsOpen="False"
                            IsClosable="True" Margin="10,0,10,10" />
            </Grid>
        </Grid>

        <!-- Image overlay (covers entire window) -->
        <Grid x:Name="imageOverlay" Grid.Row="0" Grid.RowSpan="2"
              Panel.ZIndex="100" Visibility="Collapsed"
              Background="#DD000000" Cursor="Hand"
              MouseLeftButtonUp="ImageOverlay_Close">
            <Image x:Name="overlayImage" Stretch="Uniform"
                   Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsHitTestVisible="False" />
        </Grid>
    </Grid>
</ui:FluentWindow>
