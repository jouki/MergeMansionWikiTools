<ui:FluentWindow x:Class="MergeMansionWikiTools.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:MergeMansionWikiTools.Views"
        Title="Merge Mansion Wiki Tools" Height="943" Width="1380"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="Merge Mansion Wiki Tools" Height="42" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="275" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar navigation -->
            <Border Grid.Column="0" Padding="12,8,12,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- App title in sidebar -->
                    <StackPanel Grid.Row="0" Margin="8,4,8,16">
                        <TextBlock Text="MM Wiki Tools" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="txtDataStatus" Text="No data loaded"
                                   FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Nav buttons - Windows Settings style (ListBox with custom template) -->
                    <ListBox x:Name="navList" Grid.Row="1"
                             Background="Transparent" BorderThickness="0"
                             SelectionChanged="NavList_SelectionChanged"
                             SelectedIndex="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,3" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" CornerRadius="4"
                                                    Padding="12,12" Background="Transparent">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="List24" FontSize="22" Margin="0,0,12,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Item Chains" FontSize="14" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Settings24" FontSize="22" Margin="0,0,12,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Settings" FontSize="14" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <!-- Version info -->
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock Text="v0.5.1" FontSize="10"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="by Jouki" FontSize="10"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ContentControl x:Name="contentArea" Grid.Row="0" />

                <!-- Status bar -->
                <ui:InfoBar x:Name="statusBar" Grid.Row="1" IsOpen="False"
                            IsClosable="True" Margin="10,0,10,10" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
