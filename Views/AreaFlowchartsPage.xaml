<UserControl x:Class="MergeMansionWikiTools.Views.AreaFlowchartsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Fixed header (stays visible while scrolling) -->
        <StackPanel Grid.Row="0" MaxWidth="900" HorizontalAlignment="Stretch" Margin="24,16,24,0">

            <TextBlock Text="Area Flowcharts" FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="4,0,0,20" />

            <!-- Search + Generate All row -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBox x:Name="txtSearch" Grid.Column="0"
                            PlaceholderText="Search areas..."
                            TextChanged="TxtSearch_TextChanged"
                            Margin="0,0,10,0"
                            Icon="{ui:SymbolIcon Search24}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button x:Name="btnGenerateAll" Grid.Column="0"
                                   Content="Generate All" Appearance="Primary"
                                   Click="BtnGenerateAll_Click" Height="36" />
                        <Border x:Name="btnGenerateAllSep" Grid.Column="1"
                                Width="1"
                                VerticalAlignment="Stretch"
                                Visibility="Collapsed" />
                        <ui:Button x:Name="btnGenerateAllMenu" Grid.Column="2"
                                   Appearance="Primary" Height="36" Width="30"
                                   Padding="0" Click="BtnGenerateAllMenu_Click"
                                   Visibility="Collapsed">
                            <ui:SymbolIcon Symbol="ChevronDown24" FontSize="12"
                                          Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </ui:Button>
                    </Grid>
                    <ui:Button x:Name="btnPublishDiscord"
                               Appearance="Secondary" Height="36"
                               Margin="8,0,0,0"
                               Click="BtnPublishDiscord_Click">
                        <StackPanel Orientation="Horizontal"
                                    TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}">
                            <Path Width="16" Height="12" Stretch="Uniform" Margin="0,0,6,0"
                                  Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                                  Data="M19.27 5.33C17.94 4.71 16.5 4.26 15 4a.09.09 0 0 0-.07.03c-.18.33-.39.76-.53 1.09a16.09 16.09 0 0 0-4.8 0c-.14-.34-.36-.76-.54-1.09c-.01-.02-.04-.03-.07-.03c-1.5.26-2.93.71-4.27 1.33c-.01 0-.02.01-.03.02c-2.72 4.07-3.47 8.03-3.1 11.95c0 .02.01.04.03.05c1.8 1.32 3.53 2.12 5.24 2.65c.03.01.06 0 .07-.02c.4-.55.76-1.13 1.07-1.74c.02-.04 0-.08-.04-.09c-.57-.22-1.11-.48-1.64-.78c-.04-.02-.04-.08-.01-.11c.11-.08.22-.17.33-.25c.02-.02.05-.02.07-.01c3.44 1.57 7.15 1.57 10.55 0c.02-.01.05-.01.07.01c.11.09.22.17.33.26c.04.03.04.09-.01.11c-.52.31-1.07.56-1.64.78c-.04.01-.05.06-.04.09c.32.61.68 1.19 1.07 1.74c.03.01.06.02.09.01c1.72-.53 3.45-1.33 5.25-2.65c.02-.01.03-.03.03-.05c.44-4.53-.73-8.46-3.1-11.95c-.01-.01-.02-.02-.04-.02zM8.52 14.91c-1.03 0-1.89-.95-1.89-2.12s.84-2.12 1.89-2.12c1.06 0 1.9.96 1.89 2.12c0 1.17-.84 2.12-1.89 2.12zm6.97 0c-1.03 0-1.89-.95-1.89-2.12s.84-2.12 1.89-2.12c1.06 0 1.9.96 1.89 2.12c0 1.17-.83 2.12-1.89 2.12z" />
                            <TextBlock Text="Publish to Discord" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Grid>

            <!-- Output path display -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Output:" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" Margin="4,0,8,0" />
                <TextBlock x:Name="txtOutputPath" Grid.Column="1" FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Text="Not configured — set in Settings" />
                <ui:Button x:Name="btnOpenFolder" Grid.Column="2"
                           Content="Open Folder" Appearance="Secondary"
                           Click="BtnOpenFolder_Click" Height="34"
                           Visibility="Collapsed" Margin="8,0,0,0" />
            </Grid>

        </StackPanel>

        <!-- Scrollable area list -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900" Margin="24,0,24,16">

                <!-- Loading indicator -->
                <StackPanel x:Name="loadingPanel" Visibility="Collapsed"
                            HorizontalAlignment="Center" Margin="0,40,0,0">
                    <ui:ProgressRing Width="32" Height="32" IsIndeterminate="True"
                                     HorizontalAlignment="Center" />
                    <TextBlock Text="Loading areas..." FontSize="13" Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>

                <!-- Area list -->
                <StackPanel x:Name="areaListPanel" />

                <!-- Empty state -->
                <StackPanel x:Name="emptyPanel" Visibility="Collapsed" Margin="4,20,0,0">
                    <TextBlock x:Name="txtEmpty" Text="No areas loaded. Set the areas.json path in Settings."
                               FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ui:Button x:Name="btnGoToSettings" Content="Go to Settings" Appearance="Secondary"
                               Margin="0,8,0,0" Height="34" Click="BtnGoToSettings_Click" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- InfoBar at bottom -->
        <ui:InfoBar x:Name="infoBar" Grid.Row="2" IsOpen="False"
                    IsClosable="True" Margin="10,0,10,10" />
    </Grid>
</UserControl>
