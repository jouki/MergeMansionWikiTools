<UserControl x:Class="MergeMansionWikiTools.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
        <StackPanel MaxWidth="700">

            <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="4,0,0,24" />

            <!-- chain_item_odds.json -->
            <TextBlock Text="Item Data (chain_item_odds.json)" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="4,0,0,8" />
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="4" Padding="12"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" AllowDrop="True" DragOver="FileDragOver" Drop="ChainFileDrop"
                            Background="Transparent" Margin="0,0,8,0">
                        <ui:TextBox x:Name="txtChainPath"
                                    PlaceholderText="Drag file here or browse..."
                                    IsReadOnly="True"
                                    AllowDrop="False" IsHitTestVisible="False" />
                    </Border>
                    <ui:Button Grid.Column="1" Content="Browse"
                               Appearance="Secondary" Click="BrowseChainFile_Click"
                               Margin="0,0,8,0" Height="36" />
                    <ui:Button Grid.Column="2" Content="Load"
                               Appearance="Primary" Click="LoadChainFile_Click" Height="36" />
                </Grid>
            </Border>

            <Separator Margin="0,20,0,20" Opacity="0.2" />

            <!-- areas.json -->
            <TextBlock Text="Areas Data (areas.json)" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="4,0,0,8" />
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="4" Padding="12"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" AllowDrop="True" DragOver="FileDragOver" Drop="AreasFileDrop"
                            Background="Transparent" Margin="0,0,8,0">
                        <ui:TextBox x:Name="txtAreasPath"
                                    PlaceholderText="Drag file here or browse..."
                                    IsReadOnly="True"
                                    AllowDrop="False" IsHitTestVisible="False" />
                    </Border>
                    <ui:Button Grid.Column="1" Content="Browse"
                               Appearance="Secondary" Click="BrowseAreasFile_Click" Height="36" />
                </Grid>
            </Border>

            <Separator Margin="0,20,0,20" Opacity="0.2" />

            <!-- events.json -->
            <TextBlock Text="Events Data (events.json)" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="4,0,0,8" />
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="4" Padding="12"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" AllowDrop="True" DragOver="FileDragOver" Drop="EventsFileDrop"
                            Background="Transparent" Margin="0,0,8,0">
                        <ui:TextBox x:Name="txtEventsPath"
                                    PlaceholderText="Drag file here or browse..."
                                    IsReadOnly="True"
                                    AllowDrop="False" IsHitTestVisible="False" />
                    </Border>
                    <ui:Button Grid.Column="1" Content="Browse"
                               Appearance="Secondary" Click="BrowseEventsFile_Click" Height="36" />
                </Grid>
            </Border>

            <Separator Margin="0,20,0,20" Opacity="0.2" />

            <!-- Info -->
            <TextBlock Text="File paths are saved automatically and persist between sessions."
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12"
                       Margin="4,0,0,0" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
