<UserControl x:Class="MergeMansionWikiTools.Views.ImageOptimiserPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             AllowDrop="True" DragOver="Page_DragOver" Drop="Page_Drop">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Chain mode banner (collapsed by default) -->
        <Border x:Name="chainModeBanner" Grid.Row="0" Visibility="Collapsed"
                Background="{DynamicResource AccentFillColorDefaultBrush}"
                CornerRadius="6" Padding="14,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="Link24"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                <StackPanel Grid.Column="1" Margin="10,0">
                    <TextBlock x:Name="txtChainName" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                    <TextBlock x:Name="txtChainItemCount" FontSize="11"
                               Foreground="{DynamicResource TextOnAccentFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="txtDetectionMethod" FontSize="11" Visibility="Collapsed"
                               Foreground="{DynamicResource TextOnAccentFillColorSecondaryBrush}"/>
                </StackPanel>
                <ui:Button Grid.Column="2" Content="Exit" Icon="{ui:SymbolIcon Dismiss24}"
                           Click="BtnExitChainMode_Click"
                           Background="#20000000" BorderThickness="0"
                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                           MouseOverBackground="#30000000" PressedBackground="#40000000"
                           Padding="12,6"/>
            </Grid>
        </Border>

        <!-- Row 1: Image suggestion banner (collapsed by default) -->
        <Border x:Name="imageSuggestionBanner" Grid.Row="1" Visibility="Collapsed"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="imgSuggestionPreview" Height="48" Margin="0,0,12,0"
                       VerticalAlignment="Center" Stretch="Uniform"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="txtSuggestionTitle" FontWeight="SemiBold" FontSize="13"
                               Text="Image found"/>
                    <TextBlock x:Name="txtSuggestionPath" FontSize="11"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <ui:Button Grid.Column="2" Content="Load &amp; Split"
                           Icon="{ui:SymbolIcon ImageCopy24}"
                           Appearance="Primary" Height="34" Padding="12,0"
                           Margin="10,0,0,0" VerticalAlignment="Center"
                           Click="BtnSuggestionLoad_Click"/>
                <ui:Button Grid.Column="3" Padding="6" Height="34" Width="34"
                           Appearance="Secondary" Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Click="BtnSuggestionDismiss_Click"
                           ToolTip="Dismiss" ToolTipService.InitialShowDelay="0">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14"/>
                </ui:Button>
            </Grid>
        </Border>

        <!-- Row 2: Thumbnail strip (collapsed when no images) -->
        <Border x:Name="thumbnailStripBorder" Grid.Row="2" Visibility="Collapsed"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8" Margin="0,0,0,10"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer x:Name="thumbnailScrollViewer"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Padding="6,6,0,6" PreviewMouseWheel="ThumbnailScrollViewer_PreviewMouseWheel">
                    <Grid>
                        <StackPanel x:Name="thumbnailPanel" Orientation="Horizontal"/>
                        <Canvas x:Name="insertionCanvas" IsHitTestVisible="False"/>
                    </Grid>
                </ScrollViewer>
                <ui:Button x:Name="btnClearAll" Grid.Column="1" ToolTip="Clear all images"
                           ToolTipService.InitialShowDelay="0"
                           Appearance="Secondary" Padding="6" Margin="4,0,6,0"
                           VerticalAlignment="Center" Click="BtnClearAll_Click">
                    <ui:SymbolIcon Symbol="Delete24" FontSize="16"/>
                </ui:Button>
            </Grid>
        </Border>

        <!-- Row 3: Preview / Drop zone -->
        <Border Grid.Row="3" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Margin="0,0,0,15"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Image x:Name="imgPreview" Margin="15" SizeChanged="ImgPreview_SizeChanged"/>
                <!-- Detection overlay canvas (for scissors mode) -->
                <Canvas x:Name="detectionOverlay"/>
                <!-- Auto-link offer banner -->
                <Border x:Name="autoLinkBanner" Visibility="Collapsed"
                        VerticalAlignment="Top" HorizontalAlignment="Stretch"
                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="0,0,6,6" Padding="12,8" Margin="1,0,1,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Link24" FontSize="16" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="txtAutoLinkMessage" Grid.Column="1" VerticalAlignment="Center"
                                   Margin="10,0,0,0" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:Button x:Name="btnAutoLink" Grid.Column="2"
                                   Content="Link" Icon="{ui:SymbolIcon Link24}"
                                   Appearance="Primary" Height="30" Padding="12,0"
                                   Margin="10,0,0,0" Click="BtnAutoLink_Click"/>
                        <ui:Button Grid.Column="3" Padding="4" Height="30" Width="30"
                                   Appearance="Secondary" Margin="6,0,0,0"
                                   Click="BtnAutoLinkDismiss_Click" ToolTip="Dismiss"
                                   ToolTipService.InitialShowDelay="0">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="12"/>
                        </ui:Button>
                    </Grid>
                </Border>
                <ui:TextBlock x:Name="txtPlaceholder" Text="Drag images here to optimise"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Appearance="Tertiary"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8">
                    <ui:Button x:Name="btnPredictIndices"
                               Content="Map Levels" Icon="{ui:SymbolIcon DocumentData24}"
                               Appearance="Secondary" Height="32" Padding="10,0"
                               Visibility="Collapsed" Click="BtnPredictIndices_Click"
                               ToolTip="Map detection objects to chain levels using sprite metadata"
                               ToolTipService.InitialShowDelay="0"
                               ToolTipService.ShowOnDisabled="True"
                               Margin="0,0,6,0"/>
                    <ui:Button x:Name="btnToggleRects"
                               Appearance="Secondary" Height="32" Width="32" Padding="0"
                               Visibility="Collapsed" Click="BtnToggleRects_Click"
                               ToolTip="Show/hide detection rectangles"
                               ToolTipService.InitialShowDelay="0"
                               Margin="0,0,6,0">
                        <ui:SymbolIcon x:Name="iconToggleRects" Symbol="Eye24" FontSize="16"/>
                    </ui:Button>
                    <Border x:Name="refreshButtonGroup" Visibility="Collapsed" CornerRadius="6">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button x:Name="btnDetectAlgorithm"
                                       Appearance="Secondary" Height="32" Width="32" Padding="0"
                                       Click="BtnDetectAlgorithm_Click"
                                       ToolTip="Algorithm (flood fill)"
                                       ToolTipService.InitialShowDelay="0">
                                <ui:SymbolIcon x:Name="iconAlgorithm" Symbol="BrainCircuit24" FontSize="16"/>
                            </ui:Button>
                            <ui:Button x:Name="btnDetectAtlas"
                                       Appearance="Secondary" Height="32" Width="32" Padding="0"
                                       Margin="-1,0,0,0"
                                       Click="BtnDetectAtlas_Click"
                                       ToolTip="Atlas data (sprite metadata)"
                                       ToolTipService.InitialShowDelay="0">
                                <ui:SymbolIcon x:Name="iconAtlas" Symbol="DocumentData24" FontSize="16"/>
                            </ui:Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 4: Index input (Collapsed by default — visible when scissors active) -->
        <StackPanel x:Name="indexInputPanel" Grid.Row="4" Visibility="Collapsed">
            <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" Margin="2,0,0,3"
                       Text="Use &quot;-&quot; to skip an object (e.g. 4 - 2 3 1)"/>
            <ui:TextBox x:Name="inputIndices"
                        PlaceholderText="Insert Levels (ex. 4 5 2 3 1)..."
                        AcceptsReturn="True" MinHeight="60" Margin="0,0,0,10"
                        VerticalContentAlignment="Top" TextWrapping="Wrap"
                        PreviewKeyDown="InputIndices_PreviewKeyDown"
                        TextChanged="InputIndices_TextChanged"/>
        </StackPanel>

        <!-- Row 5: Button bar -->
        <Grid Grid.Row="5" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:Button x:Name="btnUploadWiki" Grid.Column="0"
                       Content="Upload to Wiki" Icon="{ui:SymbolIcon ArrowUpload24}"
                       Appearance="Primary" Height="45" Padding="16,0"
                       IsEnabled="False" Click="BtnUploadWiki_Click"
                       HorizontalAlignment="Left" Margin="0,0,10,0"
                       ToolTip="Optimise images first"
                       ToolTipService.InitialShowDelay="0"
                       ToolTipService.ShowOnDisabled="True"/>

            <ui:Button x:Name="btnOptimizeAll" Grid.Column="1"
                       Content="Optimise All (TinyPNG)" Icon="{ui:SymbolIcon ArrowDownload24}"
                       Appearance="Secondary" Height="45"
                       HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                       Click="BtnOptimizeAll_Click"
                       ToolTipService.InitialShowDelay="0"
                       ToolTipService.ShowOnDisabled="True"/>

            <!-- Name source dropdown (visible for multi-image clusters) -->
            <ComboBox x:Name="cmbNameSource" Grid.Column="2"
                      Visibility="Collapsed" Height="45" MinWidth="180"
                      Margin="10,0,0,0" VerticalAlignment="Bottom"
                      SelectionChanged="CmbNameSource_SelectionChanged"
                      ToolTip="Select which filename to use for individual item images"
                      ToolTipService.InitialShowDelay="0"/>

            <Border x:Name="splitButtonGroup" Grid.Column="3"
                    Visibility="Collapsed" Margin="10,0,0,0" VerticalAlignment="Bottom"
                    CornerRadius="6" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:Button x:Name="btnSplit" Grid.Column="0"
                               Content="Split" Icon="{ui:SymbolIcon Cut24}"
                               Appearance="Primary" Height="45" MinWidth="110"
                               FontWeight="SemiBold" FontSize="15"
                               Padding="14,0"
                               Click="BtnSplit_Click"/>
                    <ui:Button x:Name="btnSplitDropdown" Grid.Column="1"
                               Appearance="Primary" Height="45" Width="32"
                               Padding="0" Margin="-1,0,0,0"
                               Click="BtnSplitDropdown_Click"
                               ToolTip="Choose output folder"
                               ToolTipService.InitialShowDelay="0">
                        <ui:SymbolIcon Symbol="ChevronDown24" FontSize="12"/>
                    </ui:Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 6: InfoBar + Open folder + clipboard Add button -->
        <Grid Grid.Row="6" MinHeight="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ui:InfoBar x:Name="infoBar" IsOpen="False" IsClosable="True"/>
            <ui:Button x:Name="btnOpenOutputFolder" Grid.Column="1"
                       Content="Open folder" Icon="{ui:SymbolIcon FolderOpen24}"
                       Appearance="Secondary" Height="36" Padding="14,0"
                       Margin="8,0,0,0" VerticalAlignment="Center"
                       Visibility="Collapsed" Click="BtnOpenOutputFolder_Click"
                       ToolTip="Open output folder"
                       ToolTipService.InitialShowDelay="0"/>
            <ui:Button x:Name="btnClipboardAdd" Grid.Column="2"
                       Content="Add" Icon="{ui:SymbolIcon ClipboardPaste24}"
                       Appearance="Primary" Height="36" Padding="14,0"
                       Margin="8,0,0,0" VerticalAlignment="Center"
                       Visibility="Collapsed" Click="BtnClipboardAdd_Click"/>
        </Grid>
    </Grid>
</UserControl>
