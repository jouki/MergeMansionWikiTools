<ui:FluentWindow x:Class="MergeMansionWikiTools.Views.SetupWizard"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                Title="Setup"
                Width="680" Height="620"
                MinWidth="560" MinHeight="500"
                WindowStartupLocation="CenterScreen"
                ExtendsContentIntoTitleBar="True"
                WindowBackdropType="Mica"
                Icon="/Assets/AppLogo.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <ui:TitleBar Grid.Row="0" Title="Setup" Height="42" />

        <!-- Content -->
        <Grid Grid.Row="1" Margin="32,0,32,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Welcome -->
            <TextBlock Grid.Row="0" Text="Welcome to Merge Mansion Wiki Tools"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="0,0,0,12" />

            <!-- Step indicator -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16"
                        VerticalAlignment="Center">
                <Ellipse x:Name="dot1" Width="8" Height="8" Margin="0,0,6,0" />
                <Ellipse x:Name="dot2" Width="8" Height="8" Margin="0,0,6,0" />
                <Ellipse x:Name="dot3" Width="8" Height="8" Margin="0,0,6,0" />
                <Ellipse x:Name="dot4" Width="8" Height="8" Margin="0,0,12,0" />
                <TextBlock x:Name="txtStepIndicator" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Step panels (visibility-toggled) -->
            <Grid Grid.Row="2">

                <!-- ══════════════════════════════════════════════════════════
                     STEP 1 — Workspace & Game Version
                     ══════════════════════════════════════════════════════════ -->
                <ScrollViewer x:Name="panelStep1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="20" Margin="0,0,8,0"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Workspace" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,12">
                            <Run Text="Choose a folder where you'll store game data, APK files, and exports." />
                        </TextBlock>

                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Margin="16,14,16,12">
                                <TextBlock Text="Workspace Folder" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox x:Name="txtWorkspacePath"
                                                PlaceholderText="Select a workspace folder..."
                                                IsReadOnly="True" AllowDrop="False" IsHitTestVisible="False"
                                                Margin="0,0,8,0" />
                                    <ui:Button Grid.Column="1" Content="Browse" Appearance="Secondary"
                                               Click="BrowseWorkspace_Click" Height="36" />
                                </Grid>

                                <Separator Opacity="0.15" Margin="-16,12,-16,12" />

                                <TextBlock Text="Game Version" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,0,0,10">
                                    <Run Text="Select game version. APK is downloaded into a version subfolder inside your Workspace." />
                                </TextBlock>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Version:" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,0,8,0" />
                                    <ComboBox x:Name="cmbApkVersion" Grid.Column="1" MinWidth="160"
                                              SelectionChanged="CmbApkVersion_SelectionChanged" />
                                    <ui:Button x:Name="btnRefreshVersions" Grid.Column="2"
                                               Content="&#x21bb;" Appearance="Secondary" Height="36" Width="36"
                                               Click="BtnRefreshVersions_Click" Margin="8,0,0,0"
                                               ToolTipService.InitialShowDelay="0" ToolTip="Refresh version list" />
                                    <!-- Spacer column 3 -->
                                    <ui:Button x:Name="btnCancelDownload" Grid.Column="4"
                                               Content="Cancel" Appearance="Secondary" Height="36"
                                               Click="BtnCancelDownload_Click" Visibility="Collapsed"
                                               Margin="0,0,8,0" />
                                    <ui:Button x:Name="btnDownloadApk" Grid.Column="5"
                                               Content="Download APK" Appearance="Primary" Height="36"
                                               Click="BtnDownloadApk_Click" />
                                </Grid>

                                <TextBlock x:Name="txtApkDownloadStatus"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12"
                                   Margin="4,8,0,0">
                            <Run Text="You can always change these in Settings later." />
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>

                <!-- ══════════════════════════════════════════════════════════
                     STEP 2 — Dump Files
                     ══════════════════════════════════════════════════════════ -->
                <ScrollViewer x:Name="panelStep2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Database24" FontSize="20" Margin="0,0,8,0"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Dump Files" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,12">
                            <Run Text="These JSON files contain game data extracted from the APK. Drag and drop works too!" />
                        </TextBlock>

                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                AllowDrop="True" DragOver="FileDragOver" Drop="DumpFilesCardDrop">
                            <StackPanel>

                                <!-- chain_item_odds.json -->
                                <StackPanel Margin="16,14,16,12">
                                    <TextBlock Text="chain_item_odds.json" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox x:Name="txtChainPath"
                                                    PlaceholderText="Drag file here or browse..."
                                                    IsReadOnly="True" AllowDrop="False" IsHitTestVisible="False"
                                                    Margin="0,0,8,0" />
                                        <ui:Button Grid.Column="1" Content="Browse" Appearance="Secondary"
                                                   Click="BrowseChainFile_Click" Height="36" />
                                    </Grid>
                                </StackPanel>

                                <Separator Opacity="0.15" Margin="0" />

                                <!-- areas.json -->
                                <StackPanel Margin="16,14,16,12">
                                    <TextBlock Text="areas.json" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox x:Name="txtAreasPath"
                                                    PlaceholderText="Drag file here or browse..."
                                                    IsReadOnly="True" AllowDrop="False" IsHitTestVisible="False"
                                                    Margin="0,0,8,0" />
                                        <ui:Button Grid.Column="1" Content="Browse" Appearance="Secondary"
                                                   Click="BrowseAreasFile_Click" Height="36" />
                                    </Grid>
                                </StackPanel>

                                <Separator Opacity="0.15" Margin="0" />

                                <!-- events.json -->
                                <StackPanel Margin="16,14,16,12">
                                    <TextBlock Text="events.json" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox x:Name="txtEventsPath"
                                                    PlaceholderText="Drag file here or browse..."
                                                    IsReadOnly="True" AllowDrop="False" IsHitTestVisible="False"
                                                    Margin="0,0,8,0" />
                                        <ui:Button Grid.Column="1" Content="Browse" Appearance="Secondary"
                                                   Click="BrowseEventsFile_Click" Height="36" />
                                    </Grid>
                                </StackPanel>

                            </StackPanel>
                        </Border>

                        <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12"
                                   Margin="4,8,0,0">
                            <Run Text="All steps are optional — you can set these up later in Settings." />
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>

                <!-- ══════════════════════════════════════════════════════════
                     STEP 3 — Image Splitter API
                     ══════════════════════════════════════════════════════════ -->
                <ScrollViewer x:Name="panelStep3" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="ImageEdit24" FontSize="20" Margin="0,0,8,0"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Image Splitter" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,12">
                            <Run Text="The Image Splitter compresses images using the TinyPNG API before uploading them to the wiki." />
                        </TextBlock>

                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Margin="16,14,16,12">
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,0,0,12">
                                    <Run Text="Get your " /><Run Text="free" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /><Run Text=" API key (500 compressions/month) at: " />
                                    <Hyperlink NavigateUri="https://tinify.com/developers"
                                               RequestNavigate="Hyperlink_RequestNavigate">
                                        <Run Text="tinify.com/developers" />
                                    </Hyperlink>
                                </TextBlock>

                                <TextBlock Text="Primary API Key" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Margin="0,0,0,8" />
                                <ui:TextBox x:Name="txtTinifyKey"
                                            PlaceholderText="Enter your primary TinyPNG API key..."
                                            TextChanged="TinifyKey_TextChanged" />

                                <Separator Opacity="0.15" Margin="-16,12,-16,12" />

                                <TextBlock Text="Secondary API Key" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Margin="0,0,0,4" />
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,0,0,8">
                                    <Run Text="Used as fallback if the primary key fails or runs out of credits." />
                                </TextBlock>
                                <ui:TextBox x:Name="txtTinifyKey2"
                                            PlaceholderText="Optional — leave empty to skip fallback..."
                                            TextChanged="TinifyKey2_TextChanged" />
                            </StackPanel>
                        </Border>

                        <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12"
                                   Margin="4,8,0,0">
                            <Run Text="This is optional — you can use the app without image compression. But you shouldn't upload images to the wiki without optimising them first." />
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>

                <!-- ══════════════════════════════════════════════════════════
                     STEP 4 — Automated Wiki Edits
                     ══════════════════════════════════════════════════════════ -->
                <ScrollViewer x:Name="panelStep4" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Globe24" FontSize="20" Margin="0,0,8,0"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Automated Wiki Edits" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,12">
                            <Run Text="Connect your Fandom account to enable automated wiki editing — publishing templates, moving pages, and updating references." />
                        </TextBlock>

                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Margin="16,14,16,12">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Bot Password Required" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center">
                                        <Hyperlink Click="BtnBotGuide_Click"><Run Text="How to create one" /></Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,0,0,10">
                                    <Run Text="Do not use your regular Fandom password" FontWeight="SemiBold"
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Run Text=" — it won't work via the API. Create a bot password first (see guide above)." />
                                </TextBlock>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Username:" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ui:TextBox x:Name="txtWikiBotUsername" Grid.Column="1"
                                                PlaceholderText="YourName@BotPasswordName"
                                                TextChanged="WikiBotCredentials_TextChanged" />
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Password:" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ui:PasswordBox x:Name="txtWikiBotPassword" Grid.Column="1"
                                                    PlaceholderText="Generated bot password"
                                                    PasswordChanged="WikiBotPassword_Changed" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="txtWikiBotStatus" Grid.Column="0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" />
                                    <ui:Button x:Name="btnVerifyBot" Grid.Column="1"
                                               Content="Log In" Appearance="Primary" Height="36"
                                               Click="BtnVerifyBot_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12"
                                   Margin="4,8,0,0">
                            <Run Text="You can set this up later in Settings." />
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Grid>

        <!-- Bottom navigation -->
        <Border Grid.Row="2" Padding="32,12,32,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button x:Name="btnBack" Grid.Column="0"
                           Content="Back" Appearance="Secondary" Height="36"
                           Click="BtnBack_Click" Visibility="Collapsed" />

                <!-- Spacer -->

                <ui:Button x:Name="btnSkip" Grid.Column="2"
                           Content="Skip" Appearance="Secondary" Height="36"
                           Click="BtnSkip_Click" Margin="0,0,8,0" />

                <ui:Button x:Name="btnNext" Grid.Column="3"
                           Content="Next" Appearance="Primary" Height="36"
                           Click="BtnNext_Click" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
