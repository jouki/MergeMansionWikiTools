<ui:FluentWindow x:Class="MergeMansionWikiTools.Views.BoardCellPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Pick item" Width="660" Height="580"
        MinWidth="520" MinHeight="420"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Height="36" Title="Pick item" />

        <Grid Grid.Row="1" Margin="20,8,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left: search + chain list / level list (they overlap in the same cell) -->
            <Grid Grid.Column="0">
            <!-- Step 1: chain list -->
            <Grid x:Name="chainStep">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Choose a chain or search an item" FontSize="16" FontWeight="SemiBold"
                           Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <ui:TextBox Grid.Row="1" x:Name="txtSearch" PlaceholderText="Search chain or item name…" Margin="0,0,0,8"
                            Icon="{ui:SymbolIcon Search24}" TextChanged="Search_TextChanged"/>
                <ListView Grid.Row="2" x:Name="lstChains" BorderThickness="0" Background="Transparent"
                          SelectionChanged="Chains_SelectionChanged"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Border Width="36" Height="36" Margin="0,0,10,0" ClipToBounds="True"
                                        Background="{Binding Icon}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Label}" FontSize="14"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Sub}" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Step 2: level list -->
            <Grid x:Name="levelStep" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:Button Icon="{ui:SymbolIcon ArrowLeft24}" Content="Back" Click="Back_Click" Margin="0,0,10,0"/>
                    <TextBlock x:Name="txtLevelHeader" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
                <ListView Grid.Row="1" x:Name="lstLevels" BorderThickness="0" Background="Transparent"
                          SelectionChanged="Levels_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Border Width="36" Height="36" Margin="0,0,10,0" ClipToBounds="True"
                                        Background="{Binding Icon}"/>
                                <TextBlock Text="{Binding Display}" VerticalAlignment="Center" FontSize="14"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            </Grid>

            <!-- Right: recently picked chains → jump straight to their level list -->
            <Border x:Name="recentPanel" Grid.Column="1" Width="200" Margin="14,0,0,0" Padding="12,0,0,0"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Recent chains" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ListView Grid.Row="1" x:Name="lstRecent" BorderThickness="0" Background="Transparent"
                              SelectionChanged="Recent_SelectionChanged"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Border Width="28" Height="28" Margin="0,0,8,0" ClipToBounds="True"
                                            Background="{Binding Icon}"/>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="13"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,16">
            <ui:Button x:Name="btnClear" Content="Clear tile" Icon="{ui:SymbolIcon Delete24}"
                       Click="Clear_Click" Margin="0,0,8,0"/>
            <ui:Button Content="Cancel" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
