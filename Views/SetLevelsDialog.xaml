<ui:FluentWindow x:Class="MergeMansionWikiTools.Views.SetLevelsDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Set Levels" Width="720" SizeToContent="Height"
                 MinHeight="260"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Set Levels" Height="36" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="20,8,20,20">
            <TextBlock x:Name="txtHeader" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="txtSubHeader" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

            <!-- Quick actions: operate on the whole selection at once. WrapPanel, not
                 StackPanel — the button row is wide enough that a larger font or DPI would push
                 the last NumberBox off the dialog. -->
            <WrapPanel Orientation="Horizontal" Margin="0,14,0,0">
                <ui:Button x:Name="btnSetAll" Content="Set all to" Appearance="Secondary"
                           Padding="10,6" Margin="0,0,4,0" Click="BtnSetAll_Click"
                           ToolTip="Give every selected item the level in the box" />
                <ui:NumberBox x:Name="nbSetAll" Value="1" Minimum="1" Maximum="99" SmallChange="1"
                              Width="120" ClearButtonEnabled="False"
                              VerticalAlignment="Center" Margin="0,0,12,0" />
                <ui:Button x:Name="btnMinus" Content="−1" Appearance="Secondary"
                           Padding="12,6" Margin="0,0,4,0" Click="BtnShiftDown_Click"
                           ToolTip="Shift every selected item one level down" />
                <ui:Button x:Name="btnPlus" Content="+1" Appearance="Secondary"
                           Padding="12,6" Margin="0,0,12,0" Click="BtnShiftUp_Click"
                           ToolTip="Shift every selected item one level up" />
                <ui:Button x:Name="btnRenumber" Content="Renumber from" Appearance="Secondary"
                           Padding="10,6" Margin="0,0,4,0" Click="BtnRenumber_Click"
                           ToolTip="Number the selected items consecutively, in the order shown" />
                <ui:NumberBox x:Name="nbRenumber" Value="1" Minimum="1" Maximum="99" SmallChange="1"
                              Width="120" ClearButtonEnabled="False"
                              VerticalAlignment="Center" />
            </WrapPanel>

            <!-- Per-item levels -->
            <ScrollViewer x:Name="itemsScroll" MaxHeight="380" VerticalScrollBarVisibility="Auto"
                          Margin="0,14,0,0">
                <ItemsControl x:Name="itemsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,5" Margin="0,0,0,3" CornerRadius="4"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Lv" FontSize="11" VerticalAlignment="Center"
                                               Margin="0,0,6,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <ui:NumberBox Grid.Column="1" Width="120" Minimum="1" Maximum="99" SmallChange="1"
                                                  ClearButtonEnabled="False"
                                                  Value="{Binding LevelValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ItemType}" FontSize="10"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding ChangeLabel}" FontSize="11"
                                               VerticalAlignment="Center" Margin="10,0,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="txtSummary" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <ui:Button x:Name="btnCancel" Content="Cancel" Padding="16,7" Margin="0,0,8,0"
                           Click="BtnCancel_Click" />
                <ui:Button x:Name="btnApply" Content="Apply" Appearance="Primary" Padding="16,7"
                           Click="BtnApply_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
