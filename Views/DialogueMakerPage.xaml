<UserControl x:Class="MergeMansionWikiTools.Views.DialogueMakerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
        <StackPanel MaxWidth="900">

            <TextBlock Text="Dialogue Maker" FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="4,0,0,24" />

            <!-- ══ IMAGES ════════════════════════════════════════════ -->
            <TextBlock Text="Screenshots" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="4,0,0,10" />

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    Margin="0,0,0,8">
                <StackPanel>

                    <!-- Drop zone -->
                    <Border x:Name="dropZone" AllowDrop="True"
                            DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave" Drop="DropZone_Drop"
                            Background="Transparent" CornerRadius="6"
                            BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                            BorderThickness="2" Margin="16,14,16,12"
                            MinHeight="100" Cursor="Hand"
                            MouseLeftButtonUp="DropZone_Click">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,16">
                            <ui:SymbolIcon Symbol="ImageAdd24" FontSize="32"
                                          Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          HorizontalAlignment="Center" />
                            <TextBlock Text="Drop images here, paste from clipboard (Ctrl+V), or click to browse"
                                       FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="Supported: JPG, PNG, GIF, WebP"
                                       FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Image list + drag canvas -->
                    <Grid x:Name="imageListWrapper" AllowDrop="True"
                          Background="Transparent"
                          DragOver="ImageListWrapper_DragOver"
                          DragLeave="ImageListWrapper_DragLeave"
                          Drop="ImageListWrapper_Drop">
                        <ItemsControl x:Name="imageList" Margin="16,0,16,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Canvas x:Name="dragCanvas" IsHitTestVisible="False" />
                    </Grid>

                    <Separator Opacity="0.15" Margin="0,8,0,0" />

                    <!-- Action row -->
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button x:Name="btnClear" Grid.Column="0"
                                   Content="Clear" Appearance="Secondary"
                                   Height="38" Padding="12,0"
                                   Click="BtnClear_Click" IsEnabled="False" />
                        <TextBlock x:Name="txtImageCount" Grid.Column="2"
                                   FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </Grid>

                    <ui:InfoBar x:Name="infoBar" IsOpen="False" IsClosable="True"
                                Margin="16,0,16,12" />

                </StackPanel>
            </Border>

            <!-- ══ OUTPUT ════════════════════════════════════════════ -->
            <TextBlock Text="Output" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="4,16,0,10" />

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    Margin="0,0,0,16">
                <StackPanel>

                    <Grid Margin="16,14,16,12" MinHeight="60">
                        <ScrollViewer x:Name="outputScroller" MaxHeight="400"
                                      VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Canvas x:Name="indexCanvas" Grid.Column="0"
                                        ClipToBounds="False" IsHitTestVisible="False" />
                                <TextBox x:Name="txtOutput" Grid.Column="1"
                                         IsReadOnly="True" AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Disabled"
                                         BorderThickness="0" Background="Transparent"
                                         FontFamily="Consolas" FontSize="13"
                                         Padding="0" IsTabStop="False"
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Grid>
                        </ScrollViewer>
                        <TextBlock x:Name="txtPlaceholder"
                                   Text="Processed dialogue will appear here..."
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   FontSize="13" FontFamily="Consolas"
                                   VerticalAlignment="Top" Margin="34,4,0,0" />
                    </Grid>

                    <Separator Opacity="0.15" Margin="0" />

                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button x:Name="btnCopy" Grid.Column="0"
                                   Content="Copy" Appearance="Secondary"
                                   Height="36" Padding="16,0"
                                   Click="BtnCopy_Click" IsEnabled="False" />
                    </Grid>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
