<ui:FluentWindow x:Class="MergeMansionWikiTools.Views.MergeModeHelpDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Merge Mode" Width="660" SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
    ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <!-- Lua syntax colors -->
        <SolidColorBrush x:Key="LuaComment" Color="#6A9955" />
        <SolidColorBrush x:Key="LuaString" Color="#CE9178" />
        <SolidColorBrush x:Key="LuaKeyword" Color="#569CD6" />
        <SolidColorBrush x:Key="LuaKey" Color="#9CDCFE" />
        <SolidColorBrush x:Key="LuaPunctuation" Color="#D4D4D4" />
        <SolidColorBrush x:Key="LuaWarning" Color="#FFB900" />
        <SolidColorBrush x:Key="LuaOk" Color="#4EC9B0" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Merge Mode — Advanced Feature" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,10,24,20">

                <!-- Warning InfoBar -->
                <ui:InfoBar Title="Advanced Feature"
                            Message="Only use Merge Mode if you understand how wiki chain mapping works. Incorrect merges can cause data inconsistencies on the wiki."
                            Severity="Warning" IsClosable="False" IsOpen="True"
                            Margin="0,0,0,16" />

                <!-- What is Merge Mode? -->
                <TextBlock Text="What is Merge Mode?" FontWeight="SemiBold" FontSize="14"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,0,0,6" />
                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,16">
                    Merge Mode allows you to unify multiple game data chains under a single wiki chain name.
                    This is useful when the game has many separate chains (e.g. BucketList variants) that
                    represent the same concept on the wiki. The mapping is stored in
                    <Hyperlink x:Name="lnkModule" RequestNavigate="Hyperlink_RequestNavigate"
                               NavigateUri="https://merge-mansion.fandom.com/wiki/Module:Datatable/Items/Mapping">Module:Datatable/Items/Mapping</Hyperlink>.
                </TextBlock>

                <!-- How it works -->
                <TextBlock Text="How it works" FontWeight="SemiBold" FontSize="14"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,0,0,6" />
                <StackPanel Margin="8,0,0,16">
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,4">
                        &#x2022; Select 2+ chains in the chain browser and click "Merge Chains"
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,4">
                        &#x2022; Choose a primary chain or type an existing chain name
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,4">
                        &#x2022; Primary chain items keep their normal mapping
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        &#x2022; All other (alias) chain items get isAlias = true in the wiki module
                    </TextBlock>
                </StackPanel>

                <!-- Wiki module example -->
                <TextBlock Text="Wiki module example" FontWeight="SemiBold" FontSize="14"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,0,0,6" />
                <Border Background="#1E1E1E" CornerRadius="4" Padding="14,10" Margin="0,0,0,16">
                    <TextBlock FontFamily="Consolas" FontSize="12" LineHeight="18">
                        <Run Foreground="{StaticResource LuaComment}">-- Primary item (normal mapping):</Run><LineBreak />
                        <Run Foreground="{StaticResource LuaPunctuation}">[</Run><Run Foreground="{StaticResource LuaString}">"Item_PrimaryChain_01"</Run><Run Foreground="{StaticResource LuaPunctuation}">] = {</Run><Run Foreground="{StaticResource LuaKey}">chainName</Run><Run Foreground="{StaticResource LuaPunctuation}"> = </Run><Run Foreground="{StaticResource LuaString}">"My Chain"</Run><Run Foreground="{StaticResource LuaPunctuation}">},</Run><LineBreak />
                        <LineBreak />
                        <Run Foreground="{StaticResource LuaComment}">-- Alias items (from merged chains):</Run><LineBreak />
                        <Run Foreground="{StaticResource LuaPunctuation}">[</Run><Run Foreground="{StaticResource LuaString}">"Item_AliasChainA_01"</Run><Run Foreground="{StaticResource LuaPunctuation}">] = {</Run><Run Foreground="{StaticResource LuaKey}">chainName</Run><Run Foreground="{StaticResource LuaPunctuation}"> = </Run><Run Foreground="{StaticResource LuaString}">"My Chain"</Run><Run Foreground="{StaticResource LuaPunctuation}">, </Run><Run Foreground="{StaticResource LuaKey}">isAlias</Run><Run Foreground="{StaticResource LuaPunctuation}"> = </Run><Run Foreground="{StaticResource LuaKeyword}">true</Run><Run Foreground="{StaticResource LuaPunctuation}">},</Run><LineBreak />
                        <Run Foreground="{StaticResource LuaPunctuation}">[</Run><Run Foreground="{StaticResource LuaString}">"Item_AliasChainB_01"</Run><Run Foreground="{StaticResource LuaPunctuation}">] = {</Run><Run Foreground="{StaticResource LuaKey}">chainName</Run><Run Foreground="{StaticResource LuaPunctuation}"> = </Run><Run Foreground="{StaticResource LuaString}">"My Chain"</Run><Run Foreground="{StaticResource LuaPunctuation}">, </Run><Run Foreground="{StaticResource LuaKey}">isAlias</Run><Run Foreground="{StaticResource LuaPunctuation}"> = </Run><Run Foreground="{StaticResource LuaKeyword}">true</Run><Run Foreground="{StaticResource LuaPunctuation}">},</Run>
                    </TextBlock>
                </Border>

                <!-- Difference from Move Items -->
                <TextBlock Text="Difference from Move Items" FontWeight="SemiBold" FontSize="14"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,0,0,6" />

                <!-- Move Items explanation + collision example -->
                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,4">
                    <Run FontWeight="SemiBold">Move Items:</Run>
                    <Run> Changes the chainName of specific items. Used when items genuinely belong to a different chain. Items share levels with existing chain items and level collisions are flagged:</Run>
                </TextBlock>
                <Border Background="#1E1E1E" CornerRadius="4" Padding="14,10" Margin="0,0,0,10">
                    <TextBlock FontFamily="Consolas" FontSize="12" LineHeight="18">
                        <Run Foreground="{StaticResource LuaComment}">-- Both items are level 1 with the same chainName</Run><LineBreak />
                        <Run Foreground="{StaticResource LuaComment}">-- → </Run><Run Foreground="{StaticResource LuaWarning}">⚠ Level collision detected</Run><LineBreak />
                        <Run Foreground="{StaticResource LuaPunctuation}">[</Run><Run Foreground="{StaticResource LuaString}">"Item_ChainA_01"</Run><Run Foreground="{StaticResource LuaPunctuation}">] = {</Run><Run Foreground="{StaticResource LuaKey}">chainName</Run><Run Foreground="{StaticResource LuaPunctuation}"> = </Run><Run Foreground="{StaticResource LuaString}">"My Chain"</Run><Run Foreground="{StaticResource LuaPunctuation}">},</Run><LineBreak />
                        <Run Foreground="{StaticResource LuaPunctuation}">[</Run><Run Foreground="{StaticResource LuaString}">"Item_ChainB_01"</Run><Run Foreground="{StaticResource LuaPunctuation}">] = {</Run><Run Foreground="{StaticResource LuaKey}">chainName</Run><Run Foreground="{StaticResource LuaPunctuation}"> = </Run><Run Foreground="{StaticResource LuaString}">"My Chain"</Run><Run Foreground="{StaticResource LuaPunctuation}">},</Run>
                    </TextBlock>
                </Border>

                <!-- Merge Mode explanation + no collision example -->
                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,4">
                    <Run FontWeight="SemiBold">Merge Mode (isAlias):</Run>
                    <Run> Maps entire chains as aliases. Alias items don't trigger level collision warnings — they're recognized as duplicates/variants of the primary items:</Run>
                </TextBlock>
                <Border Background="#1E1E1E" CornerRadius="4" Padding="14,10" Margin="0,0,0,16">
                    <TextBlock FontFamily="Consolas" FontSize="12" LineHeight="18">
                        <Run Foreground="{StaticResource LuaComment}">-- Both items are level 1, but alias is excluded from collision check</Run><LineBreak />
                        <Run Foreground="{StaticResource LuaComment}">-- → </Run><Run Foreground="{StaticResource LuaOk}">✓ No collision</Run><LineBreak />
                        <Run Foreground="{StaticResource LuaPunctuation}">[</Run><Run Foreground="{StaticResource LuaString}">"Item_ChainA_01"</Run><Run Foreground="{StaticResource LuaPunctuation}">] = {</Run><Run Foreground="{StaticResource LuaKey}">chainName</Run><Run Foreground="{StaticResource LuaPunctuation}"> = </Run><Run Foreground="{StaticResource LuaString}">"My Chain"</Run><Run Foreground="{StaticResource LuaPunctuation}">},</Run><LineBreak />
                        <Run Foreground="{StaticResource LuaPunctuation}">[</Run><Run Foreground="{StaticResource LuaString}">"Item_ChainB_01"</Run><Run Foreground="{StaticResource LuaPunctuation}">] = {</Run><Run Foreground="{StaticResource LuaKey}">chainName</Run><Run Foreground="{StaticResource LuaPunctuation}"> = </Run><Run Foreground="{StaticResource LuaString}">"My Chain"</Run><Run Foreground="{StaticResource LuaPunctuation}">, </Run><Run Foreground="{StaticResource LuaKey}">isAlias</Run><Run Foreground="{StaticResource LuaPunctuation}"> = </Run><Run Foreground="{StaticResource LuaKeyword}">true</Run><Run Foreground="{StaticResource LuaPunctuation}">},</Run>
                    </TextBlock>
                </Border>

                <!-- Level Collisions -->
                <TextBlock Text="Level Collisions" FontWeight="SemiBold" FontSize="14"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,0,0,6" />
                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,20">
                    When multiple items share the same level in a merged chain, alias items are excluded
                    from collision detection. Only collisions between non-alias items are flagged.
                </TextBlock>

                <!-- Close button -->
                <ui:Button Content="Close" Appearance="Primary"
                           HorizontalAlignment="Right" Padding="20,6"
                           Click="BtnClose_Click" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
