<UserControl x:Class="MergeMansionWikiTools.Views.GameDataDumperPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,16">
        <StackPanel MaxWidth="900">

            <TextBlock Text="Game Data Dumper" FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="4,0,0,24" />

            <!-- ══ INPUT FILES ════════════════════════════════════════ -->
            <Grid Margin="4,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Input Files" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center" />
                <ui:Button x:Name="btnPullFromPhone" Grid.Column="1"
                           Appearance="Primary" Height="34" Padding="14,0"
                           Click="BtnPullFromPhone_Click"
                           ToolTip="Detect connected Android phone and copy game data files"
                           ToolTipService.InitialShowDelay="0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Phone24" FontSize="16" Margin="0,0,6,0" />
                        <TextBlock Text="Pull from Phone" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>
            </Grid>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    Margin="0,0,0,16">
                <StackPanel Margin="16,14,16,14">

                    <!-- Config archive (required) -->
                    <TextBlock Text="Config archive" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" AllowDrop="True" CornerRadius="4"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                Drop="ConfigPath_Drop" DragOver="Path_DragOver">
                            <TextBox x:Name="txtConfigPath" AllowDrop="False" IsHitTestVisible="False"
                                     IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                     FontSize="12" VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                     Text="Drop config archive file here or browse..." />
                        </Border>
                        <ui:Button Grid.Column="1" Appearance="Secondary" Height="34" Margin="8,0,0,0"
                                   ToolTip="Browse for config archive"
                                   Click="BtnBrowseConfig_Click">
                            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" />
                        </ui:Button>
                    </Grid>

                    <!-- Patch config (optional) -->
                    <TextBlock FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,6">
                        <Run Text="Patch config" FontWeight="SemiBold" />
                        <Run Text="(optional)" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </TextBlock>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" AllowDrop="True" CornerRadius="4"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                Drop="PatchPath_Drop" DragOver="Path_DragOver">
                            <TextBox x:Name="txtPatchPath" AllowDrop="False" IsHitTestVisible="False"
                                     IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                     FontSize="12" VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                     Text="Drop patch config file here or browse..." />
                        </Border>
                        <ui:Button Grid.Column="1" Appearance="Secondary" Height="34" Margin="8,0,0,0"
                                   ToolTip="Browse for patch config"
                                   Click="BtnBrowsePatch_Click">
                            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" />
                        </ui:Button>
                    </Grid>

                    <!-- Language file (optional) -->
                    <TextBlock FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,6">
                        <Run Text="Language file" FontWeight="SemiBold" />
                        <Run Text="(optional)" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </TextBlock>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" AllowDrop="True" CornerRadius="4"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                Drop="LanguagePath_Drop" DragOver="Path_DragOver">
                            <TextBox x:Name="txtLanguagePath" AllowDrop="False" IsHitTestVisible="False"
                                     IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                     FontSize="12" VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                     Text="Drop language file here or browse..." />
                        </Border>
                        <ui:Button Grid.Column="1" Appearance="Secondary" Height="34" Margin="8,0,0,0"
                                   ToolTip="Browse for language file"
                                   Click="BtnBrowseLanguage_Click">
                            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" />
                        </ui:Button>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- ══ AUTO-DETECT ════════════════════════════════════════ -->
            <TextBlock x:Name="txtAutoDetect" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Margin="4,-10,0,12" />

            <!-- ══ MAIN DUMP ═════════════════════════════════════════════ -->
            <TextBlock Text="Main Dump" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="4,8,0,10" />
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    Margin="0,0,0,16">
                <StackPanel Margin="16,14,16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="chkChains" Grid.Column="0" Content="Chains"
                                  VerticalAlignment="Center" Checked="DumpCheckbox_Changed" Unchecked="DumpCheckbox_Changed" />
                        <CheckBox x:Name="chkAreas" Grid.Column="1" Content="Areas"
                                  VerticalAlignment="Center" Margin="12,0,0,0"
                                  Checked="DumpCheckbox_Changed" Unchecked="DumpCheckbox_Changed" />
                        <CheckBox x:Name="chkEvents" Grid.Column="2" Content="Events"
                                  VerticalAlignment="Center" Margin="12,0,0,0"
                                  Checked="chkEvents_Changed" Unchecked="chkEvents_Changed" />
                        <CheckBox x:Name="chkDialogues" Grid.Column="3" Content="Dialogues"
                                  VerticalAlignment="Center" Margin="12,0,0,0"
                                  Checked="DumpCheckbox_Changed" Unchecked="DumpCheckbox_Changed" />
                        <CheckBox x:Name="chkCards" Grid.Column="4" Content="Cards"
                                  VerticalAlignment="Center" Margin="12,0,0,0"
                                  Checked="DumpCheckbox_Changed" Unchecked="DumpCheckbox_Changed" />
                        <!-- Split Dump button -->
                        <ui:Button x:Name="btnDump" Grid.Column="6"
                                   Content="Dump" Appearance="Primary" Height="38" Padding="20,0"
                                   Click="BtnDump_Click" />
                        <Border x:Name="btnDumpSep" Grid.Column="7"
                                Width="1" Height="38"
                                VerticalAlignment="Center" />
                        <ui:Button x:Name="btnDumpMenu" Grid.Column="8"
                                   Appearance="Primary" Height="38" Width="30" Padding="0"
                                   Click="BtnDumpMenu_Click">
                            <ui:SymbolIcon Symbol="ChevronDown24" FontSize="12"
                                          Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </ui:Button>
                    </Grid>

                    <!-- Events sub-checkboxes (Expander) -->
                    <Expander x:Name="expEventCategories"
                              Header="Event Filters" IsExpanded="False" Visibility="Collapsed"
                              Margin="0,8,0,0"
                              Expanded="EventExpander_Changed" Collapsed="EventExpander_Changed">
                        <StackPanel>
                            <!-- Select All / Deselect All / Recommended -->
                            <StackPanel Orientation="Horizontal" Margin="16,4,0,2">
                                <ui:Button Content="Select All" FontSize="11" Height="24" Padding="8,0"
                                           Appearance="Secondary" Click="BtnSelectAllEvents_Click" />
                                <ui:Button Content="Deselect All" FontSize="11" Height="24" Padding="8,0" Margin="6,0,0,0"
                                           Appearance="Secondary" Click="BtnDeselectAllEvents_Click" />
                                <ui:Button Content="Recommended" FontSize="11" Height="24" Padding="8,0" Margin="6,0,0,0"
                                           Appearance="Secondary" Click="BtnRecommendedEvents_Click" />
                            </StackPanel>
                            <Grid Margin="16,2,0,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Row 0 -->
                                <CheckBox x:Name="chkEvSeasonal" Grid.Row="0" Grid.Column="0"
                                          Content="Seasonal Events" FontSize="11"
                                          ToolTipService.InitialShowDelay="0"
                                          Checked="EventSubCheckbox_Changed" Unchecked="EventSubCheckbox_Changed">
                                    <CheckBox.ToolTip>
                                        <TextBlock Text="Seasonal &amp; themed board events:&#x0a;Maddie in Paris / Japan&#x0a;Holiday Workshop / Carols&#x0a;Easter / Halloween / Anniversary&#x0a;Pirates of Hopewellbay&#x0a;Hopeberry / Flashback / ..." />
                                    </CheckBox.ToolTip>
                                </CheckBox>
                                <CheckBox x:Name="chkEvGarageCleanup" Grid.Row="0" Grid.Column="1"
                                          Content="Garage Cleanup" FontSize="11" Margin="8,0,0,0"
                                          ToolTip="Garage cleanup mini-events"
                                          ToolTipService.InitialShowDelay="0"
                                          Checked="EventSubCheckbox_Changed" Unchecked="EventSubCheckbox_Changed" />
                                <CheckBox x:Name="chkEvMysteries" Grid.Row="0" Grid.Column="2"
                                          Content="Mysteries" FontSize="11" Margin="8,0,0,0"
                                          ToolTipService.InitialShowDelay="0"
                                          Checked="EventSubCheckbox_Changed" Unchecked="EventSubCheckbox_Changed">
                                    <CheckBox.ToolTip>
                                        <TextBlock Text="Season Pass progression events (SP_*)&#x0a;Yoga, Pickleball, Love Potion, ..." />
                                    </CheckBox.ToolTip>
                                </CheckBox>
                                <CheckBox x:Name="chkEvBakeOff" Grid.Row="0" Grid.Column="3"
                                          Content="The Great Bake Off" FontSize="11" Margin="8,0,0,0"
                                          ToolTip="The Great Bake Off leaderboard event"
                                          ToolTipService.InitialShowDelay="0"
                                          Checked="EventSubCheckbox_Changed" Unchecked="EventSubCheckbox_Changed" />
                                <CheckBox x:Name="chkEvBonanza" Grid.Row="0" Grid.Column="4"
                                          Content="Bush Bonanza" FontSize="11" Margin="8,0,0,0"
                                          ToolTip="Bush Bonanza leaderboard event"
                                          ToolTipService.InitialShowDelay="0"
                                          Checked="EventSubCheckbox_Changed" Unchecked="EventSubCheckbox_Changed" />
                                <!-- Row 1 -->
                                <CheckBox x:Name="chkEvLuckyCatch" Grid.Row="1" Grid.Column="0"
                                          Content="Lucky Catch" FontSize="11"
                                          ToolTipService.InitialShowDelay="0"
                                          Checked="EventSubCheckbox_Changed" Unchecked="EventSubCheckbox_Changed">
                                    <CheckBox.ToolTip>
                                        <TextBlock Text="Lucky Catch events:&#x0a;Lucky Catch Spring / Summer / Autumn / Winter / Halloween" />
                                    </CheckBox.ToolTip>
                                </CheckBox>
                                <CheckBox x:Name="chkEvLuckySnap" Grid.Row="1" Grid.Column="1"
                                          Content="Lucky Snap" FontSize="11" Margin="8,0,0,0"
                                          ToolTipService.InitialShowDelay="0"
                                          Checked="EventSubCheckbox_Changed" Unchecked="EventSubCheckbox_Changed">
                                    <CheckBox.ToolTip>
                                        <TextBlock Text="Lucky Snap events:&#x0a;Lucky Snap Generic / Easter / Spring / Summer / Autumn / Winter" />
                                    </CheckBox.ToolTip>
                                </CheckBox>
                                <CheckBox x:Name="chkEvReArchaeology" Grid.Row="1" Grid.Column="2"
                                          Content="Re-Archaeology" FontSize="11" Margin="8,0,0,0"
                                          ToolTipService.InitialShowDelay="0"
                                          Checked="EventSubCheckbox_Changed" Unchecked="EventSubCheckbox_Changed">
                                    <CheckBox.ToolTip>
                                        <TextBlock Text="Re-Archaeology dig events:&#x0a;Fossil / Egypt / Medieval / Greece&#x0a;StoneAge / Aztec / Japan / Vikings&#x0a;Celtic / Assyria / America / ..." />
                                    </CheckBox.ToolTip>
                                </CheckBox>
                                <CheckBox x:Name="chkEvBoultonLeague" Grid.Row="1" Grid.Column="3"
                                          Content="Boulton League" FontSize="11" Margin="8,0,0,0"
                                          ToolTip="Boulton League competitive events and stages"
                                          ToolTipService.InitialShowDelay="0"
                                          Checked="EventSubCheckbox_Changed" Unchecked="EventSubCheckbox_Changed" />
                                <CheckBox x:Name="chkEvHorizonsCup" Grid.Row="1" Grid.Column="4"
                                          Content="Horizons Cup" FontSize="11" Margin="8,0,0,0"
                                          ToolTipService.InitialShowDelay="0"
                                          Checked="EventSubCheckbox_Changed" Unchecked="EventSubCheckbox_Changed">
                                    <CheckBox.ToolTip>
                                        <TextBlock Text="Hopewell Bay Horizons Cup&#x0a;(Classic Races — Sailing)" />
                                    </CheckBox.ToolTip>
                                </CheckBox>
                                <!-- Row 2 -->
                                <CheckBox x:Name="chkEvRollTheDice" Grid.Row="2" Grid.Column="0"
                                          Content="Roll The Dice" FontSize="11"
                                          ToolTip="Roll The Dice mini-events"
                                          ToolTipService.InitialShowDelay="0"
                                          Checked="EventSubCheckbox_Changed" Unchecked="EventSubCheckbox_Changed" />
                                <CheckBox x:Name="chkEvLegacy" Grid.Row="2" Grid.Column="1"
                                          Content="Legacy" FontSize="11" Margin="8,0,0,0"
                                          ToolTipService.InitialShowDelay="0"
                                          Checked="EventSubCheckbox_Changed" Unchecked="EventSubCheckbox_Changed">
                                    <CheckBox.ToolTip>
                                        <TextBlock Text="Legacy board events:&#x0a;Lost Gemstones (Gem Mining)&#x0a;The Great Escape (Jailbreak)" />
                                    </CheckBox.ToolTip>
                                </CheckBox>
                                <CheckBox x:Name="chkEvOthers" Grid.Row="2" Grid.Column="2"
                                          Content="Others" FontSize="11" Margin="8,0,0,0"
                                          ToolTip="Shops, Daily Tasks"
                                          ToolTipService.InitialShowDelay="0"
                                          Checked="EventSubCheckbox_Changed" Unchecked="EventSubCheckbox_Changed" />
                                <CheckBox x:Name="chkEvUncategorised" Grid.Row="2" Grid.Column="3"
                                          Content="Uncategorised" FontSize="11" Margin="8,0,0,0"
                                          ToolTipService.InitialShowDelay="0"
                                          Checked="EventSubCheckbox_Changed" Unchecked="EventSubCheckbox_Changed">
                                    <CheckBox.ToolTip>
                                        <TextBlock Text="Events without specific classification:&#x0a;Builder events, etc." />
                                    </CheckBox.ToolTip>
                                </CheckBox>
                            </Grid>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- ══ EXPERIMENTAL DUMP ══════════════════════════════════════ -->
            <TextBlock Text="Experimental Dump" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="4,8,0,10" />
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    Margin="0,0,0,16">
                <Grid Margin="16,14,16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="12" TextWrapping="Wrap" Margin="0,0,16,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Dumps additional data (DigEvent, Pets, Offers, DailyChallenges). Each section is saved as a separate JSON file." />
                    <ui:Button x:Name="btnDumpExperimental" Grid.Column="1" Content="Dump"
                               Appearance="Secondary" Height="38" Padding="20,0"
                               VerticalAlignment="Center"
                               Click="BtnDumpExperimental_Click" />
                </Grid>
            </Border>

            <!-- ══ PROGRESS LOG ════════════════════════════════════════ -->
            <Grid Margin="4,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Log" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center" />
                <StackPanel x:Name="dumpFolderRow" Grid.Column="1" Orientation="Horizontal"
                            Visibility="Collapsed">
                    <ui:Button x:Name="btnOpenDumpFolder" Appearance="Secondary" Height="34"
                               Click="BtnOpenDumpFolder_Click"
                               ToolTip="Open the dump output folder in Explorer"
                               ToolTipService.InitialShowDelay="0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="Open Dump Folder" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button x:Name="btnUseDumpFiles" Appearance="Primary" Height="34"
                               Visibility="Collapsed" Margin="8,0,0,0"
                               Click="BtnUseDumpFiles_Click"
                               ToolTip="Use the freshly dumped files as data source for the app"
                               ToolTipService.InitialShowDelay="0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowCircleRight24" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="Load Dumped Files" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button x:Name="btnPublishDiscord" Appearance="Secondary" Height="34"
                               Visibility="Collapsed" Margin="8,0,0,0"
                               Click="BtnPublishDiscord_Click"
                               ToolTip="Publish dump ZIP to Discord channel"
                               ToolTipService.InitialShowDelay="0"
                               ToolTipService.ShowOnDisabled="True">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Send24" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="Publish to Discord" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,16" Height="160">
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <ScrollViewer x:Name="logScroller" VerticalScrollBarVisibility="Auto" Padding="16,12">
                        <TextBlock x:Name="txtLog" FontSize="12" FontFamily="Cascadia Code,Consolas,Courier New"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Text="Ready." />
                    </ScrollViewer>
                </Border>
                <!-- Log action buttons (overlay, top-right) -->
                <StackPanel x:Name="logActionButtons" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,6,16,0" Visibility="Collapsed">
                    <ui:Button x:Name="btnCopyLog" Appearance="Secondary"
                               Width="28" Height="28" Padding="0"
                               Click="BtnCopyLog_Click"
                               ToolTip="Copy log to clipboard"
                               ToolTipService.InitialShowDelay="0">
                        <ui:SymbolIcon Symbol="Copy24" FontSize="14" />
                    </ui:Button>
                    <ui:Button x:Name="btnOpenLogFile" Appearance="Secondary"
                               Width="28" Height="28" Padding="0" Margin="4,0,0,0"
                               Click="BtnOpenLogFile_Click"
                               ToolTip="Open dump log file"
                               ToolTipService.InitialShowDelay="0">
                        <ui:SymbolIcon Symbol="DocumentText24" FontSize="14" />
                    </ui:Button>
                    <ui:Button x:Name="btnOpenLogsFolder" Appearance="Secondary"
                               Width="28" Height="28" Padding="0" Margin="4,0,0,0"
                               Click="BtnOpenLogsFolder_Click"
                               ToolTip="Open logs folder"
                               ToolTipService.InitialShowDelay="0">
                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" />
                    </ui:Button>
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>

    <!-- ══ RESULT (fixed at bottom, outside ScrollViewer) ═════ -->
    <ui:InfoBar x:Name="resultInfoBar" Grid.Row="1" IsOpen="False" IsClosable="True"
                Margin="24,0,24,8" />

    </Grid>

</UserControl>
