<UserControl x:Class="MergeMansionWikiTools.Views.MysteryImagesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:MergeMansionWikiTools.Views">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Export path info -->
        <TextBlock x:Name="txtExportPath" Grid.Row="0" FontSize="11"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Margin="0,0,0,6" TextTrimming="CharacterEllipsis" />

        <!-- File list area -->
        <Border Grid.Row="1" CornerRadius="4" BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
            <Grid>
                <StackPanel x:Name="pnlLoading" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True" Width="36" Height="36" />
                    <TextBlock Text="Scanning files..." FontSize="12" Margin="0,10,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel x:Name="pnlEmpty" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <ui:SymbolIcon Symbol="Image24" FontSize="32"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="txtEmptyMessage" Text="No image files found."
                               FontSize="12" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="400" />
                </StackPanel>

                <ScrollViewer x:Name="scrollFiles" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="pnlFiles" Margin="8,6,8,6" />
                </ScrollViewer>

                <!-- Image preview overlay -->
                <Border x:Name="previewOverlay" Visibility="Collapsed"
                        Background="#E0000000" CornerRadius="4"
                        MouseLeftButtonDown="PreviewOverlay_MouseDown"
                        MouseLeftButtonUp="PreviewOverlay_MouseUp"
                        MouseMove="PreviewOverlay_MouseMove"
                        PreviewMouseWheel="PreviewScroll_MouseWheel">
                    <Grid>
                        <Canvas x:Name="previewCanvas" ClipToBounds="True"
                                SizeChanged="PreviewCanvas_SizeChanged">
                            <Image x:Name="previewImage" Stretch="Fill" />
                        </Canvas>
                        <TextBlock x:Name="txtPreviewInfo" FontSize="11"
                                   Foreground="#99FFFFFF" HorizontalAlignment="Right"
                                   VerticalAlignment="Top" Margin="0,8,12,0"
                                   IsHitTestVisible="False" />
                        <Border Background="#40000000" CornerRadius="4"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,12,12" Padding="8,4"
                                MouseLeftButtonDown="PreviewClose_Click" Cursor="Hand">
                            <TextBlock Text="Close preview" FontSize="11" Foreground="#CCFFFFFF" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Info bar -->
        <ui:InfoBar x:Name="infoBar" Grid.Row="2" IsOpen="False"
                    IsClosable="True" Margin="0,8,0,0" />

        <!-- TinyPNG usage bar -->
        <local:TinifyUsageBarsControl x:Name="tinifyUsage" Grid.Row="3" Margin="0,10,0,0"/>

        <!-- Bottom buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <ui:Button x:Name="btnOptimize" Content="Optimize (TinyPNG)" Appearance="Secondary"
                       Click="BtnOptimize_Click" IsEnabled="False" Margin="0,0,8,0" />
            <ui:Button x:Name="btnUpload" Content="Upload Selected" Appearance="Primary"
                       Click="BtnUpload_Click" IsEnabled="False" />
        </StackPanel>
    </Grid>
</UserControl>
